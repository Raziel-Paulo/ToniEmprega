@model ToniEmprega.Models.Oferta
@{
    ViewData["Title"] = "Editar Oferta";
    var latStr = Model.Latitude ?? "";
    var lngStr = Model.Longitude ?? "";
    var temCoordenadas = !string.IsNullOrEmpty(latStr) && !string.IsNullOrEmpty(lngStr);
}

<div style="max-width: 900px; margin: 0 auto;">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title"><i class="fas fa-edit"></i> Editar Oferta</h2>
        </div>

        <div asp-validation-summary="All" class="alert alert-error" style="margin: 1rem 0; display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <form method="post" id="formOferta">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label class="form-label">Título</label>
                <input asp-for="Titulo" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Tipo</label>
                <select asp-for="Id_Tipo_Oferta" class="form-control" required>
                    @foreach (var tipo in ViewBag.TiposOferta)
                    {
                        <option value="@tipo.Id">@tipo.Designacao</option>
                    }
                </select>
            </div>

            <!-- 🗺️ Localização com Mapa Interativo Leaflet -->
            <div class="form-group">
                <label class="form-label"><i class="fas fa-map-marker-alt"></i> Localização <span style="color: var(--color-danger);">*</span></label>
                
                <div class="input-group" style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <input type="text" id="pesquisa-morada" class="form-control" 
                           placeholder="Digite a morada e clique em Pesquisar..."
                           style="flex: 1;" autocomplete="off" />
                    <button type="button" class="btn btn-primary" onclick="pesquisarMorada()">
                        <i class="fas fa-search"></i> Pesquisar
                    </button>
                </div>
                <small style="color: var(--color-gray); display: block; margin-bottom: 0.5rem;">
                    <i class="fas fa-info-circle"></i> Pesquise uma morada ou clique diretamente no mapa para selecionar
                </small>

                <div id="mapa-localizacao" style="width: 100%; height: 350px; border-radius: 8px; border: 2px solid var(--color-navy);"></div>
                
                <div id="coordenadas-info" style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--color-gray);">
                    @if (temCoordenadas)
                    {
                        <span><i class="fas fa-check-circle" style="color: #28a745;"></i> <strong>Localização atual:</strong> @latStr, @lngStr</span>
                    }
                    else
                    {
                        <span><i class="fas fa-hand-pointer"></i> Clique no mapa para selecionar a localização</span>
                    }
                </div>

                <input type="text" asp-for="Localizacao" class="form-control" id="localizacao" required
                       style="margin-top: 0.75rem;" readonly />
                
                <input type="hidden" asp-for="Latitude" id="latitude" />
                <input type="hidden" asp-for="Longitude" id="longitude" />
            </div>

            <div class="form-group">
                <label class="form-label">Descrição</label>
                <textarea asp-for="Descricao" class="form-control" rows="4" required></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Requisitos</label>
                <textarea asp-for="Requisitos" class="form-control" rows="3" required></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Data de Expiração (opcional)</label>
                <input asp-for="Data_Expiracao" type="date" class="form-control" />
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Guardar Alterações
                </button>
                <a href="/Empresa/MinhasOfertas" class="btn btn-outline">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>

<script>
    let mapa;
    let marcador;
    
    const LAT_ATUAL = @(string.IsNullOrEmpty(latStr) ? "38.7223" : latStr);
    const LNG_ATUAL = @(string.IsNullOrEmpty(lngStr) ? "-9.1393" : lngStr);
    const TEM_COORDENADAS = @(temCoordenadas ? "true" : "false");

    document.addEventListener('DOMContentLoaded', function() {
        inicializarMapa();
    });

    function inicializarMapa() {
        const zoomInicial = TEM_COORDENADAS ? 15 : 7;
        mapa = L.map('mapa-localizacao').setView([LAT_ATUAL, LNG_ATUAL], zoomInicial);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(mapa);

        if (TEM_COORDENADAS) {
            marcador = L.marker([LAT_ATUAL, LNG_ATUAL]).addTo(mapa);
            marcador.bindPopup('<b>Localização atual</b>').openPopup();
        }

        mapa.on('click', function(e) {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;
            atualizarMarcador(lat, lng);
            obterMoradaPorCoordenadas(lat, lng);
        });
    }

    function atualizarMarcador(lat, lng) {
        if (marcador) {
            mapa.removeLayer(marcador);
        }

        marcador = L.marker([lat, lng]).addTo(mapa);
        marcador.bindPopup('<b>Nova localização!</b><br>Lat: ' + lat.toFixed(5) + '<br>Lng: ' + lng.toFixed(5)).openPopup();

        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;

        document.getElementById('coordenadas-info').innerHTML = 
            '<i class="fas fa-check-circle" style="color: #28a745;"></i> <strong>Nova coordenada:</strong> ' + 
            lat.toFixed(6) + ', ' + lng.toFixed(6);
    }

    async function pesquisarMorada() {
        const morada = document.getElementById('pesquisa-morada').value.trim();

        if (!morada) {
            alert('Por favor, digite uma morada para pesquisar.');
            return;
        }

        const btn = document.querySelector('button[onclick="pesquisarMorada()"]');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A pesquisar...';
        btn.disabled = true;

        try {
            const url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + 
                       encodeURIComponent(morada + ', Portugal') + '&limit=1';

            const response = await fetch(url, {
                headers: { 'User-Agent': 'ToniEmprega/1.0' }
            });

            const data = await response.json();

            if (data && data.length > 0) {
                const resultado = data[0];
                const lat = parseFloat(resultado.lat);
                const lng = parseFloat(resultado.lon);

                mapa.setView([lat, lng], 16);
                atualizarMarcador(lat, lng);
                document.getElementById('localizacao').value = resultado.display_name;
            } else {
                alert('Morada não encontrada. Tente ser mais específico ou clique no mapa.');
            }
        } catch (error) {
            console.error('Erro na pesquisa:', error);
            alert('Erro ao pesquisar morada. Verifique a ligação à internet.');
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }

    async function obterMoradaPorCoordenadas(lat, lng) {
        try {
            const url = 'https://nominatim.openstreetmap.org/reverse?format=json&lat=' + 
                       lat + '&lon=' + lng + '&zoom=18&addressdetails=1';

            const response = await fetch(url, {
                headers: { 'User-Agent': 'ToniEmprega/1.0' }
            });

            const data = await response.json();

            if (data && data.display_name) {
                document.getElementById('localizacao').value = data.display_name;
            } else {
                document.getElementById('localizacao').value = 'Lat: ' + lat.toFixed(5) + ', Lng: ' + lng.toFixed(5);
            }
        } catch (error) {
            document.getElementById('localizacao').value = 'Lat: ' + lat.toFixed(5) + ', Lng: ' + lng.toFixed(5);
        }
    }

    document.getElementById('pesquisa-morada').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            pesquisarMorada();
        }
    });

    document.getElementById('formOferta').addEventListener('submit', function(e) {
        const localizacao = document.getElementById('localizacao').value;
        const lat = document.getElementById('latitude').value;
        const lng = document.getElementById('longitude').value;

        if (localizacao.length < 5) {
            e.preventDefault();
            alert('Por favor, selecione uma localização válida no mapa.');
            return false;
        }
        if (!lat || !lng) {
            e.preventDefault();
            alert('Por favor, clique no mapa para selecionar a localização exata.');
            return false;
        }
        return true;
    });
</script>