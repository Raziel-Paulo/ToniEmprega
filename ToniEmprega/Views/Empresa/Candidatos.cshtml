@* Views/Empresa/Candidatos.cshtml *@
@model IEnumerable<ToniEmprega.Models.Candidatura>
@{
    ViewData["Title"] = "Candidatos";
    var oferta = ViewBag.Oferta as Oferta;
}

<style>
    .candidatos-wrapper {
        display: flex;
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .candidatos-sidebar {
        width: 250px;
        flex-shrink: 0;
    }

        .candidatos-sidebar .menu-card {
            background: var(--color-card-bg);
            border: 1px solid var(--color-navy);
            border-radius: 12px;
            padding: 1.5rem;
        }

        .candidatos-sidebar .menu-title {
            color: var(--color-blue);
            margin-bottom: 1.5rem;
            font-size: 1.2rem;
        }

        .candidatos-sidebar .menu-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--color-gray);
            text-decoration: none;
            margin-bottom: 0.5rem;
            transition: all 0.2s;
        }

            .candidatos-sidebar .menu-link:hover {
                background: var(--color-navy);
                color: var(--color-blue);
            }

            .candidatos-sidebar .menu-link.active {
                background: var(--color-navy);
                color: var(--color-blue);
            }

    .candidatos-main {
        flex: 1;
        min-width: 0;
    }

    .candidatos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .candidatos-table-card {
        background: var(--color-card-bg);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
        padding: 1.5rem;
        overflow-x: auto;
    }

    .candidatos-table {
        width: 100%;
        border-collapse: collapse;
    }

        .candidatos-table th {
            text-align: left;
            padding: 1rem;
            color: var(--color-blue);
            border-bottom: 2px solid var(--color-navy);
            white-space: nowrap;
        }

        .candidatos-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--color-navy);
            vertical-align: top;
        }

        .candidatos-table tr:last-child td {
            border-bottom: none;
        }

    .ficheiros-lista {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .ficheiro-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.8rem;
        background: transparent;
        border: 1px solid var(--color-blue);
        color: var(--color-blue);
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.85rem;
        white-space: nowrap;
        transition: all 0.2s;
    }

        .ficheiro-btn:hover {
            background: var(--color-blue);
            color: var(--color-white);
        }

    .badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge-prof-aproved {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .badge-empresa-pendente {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .badge-empresa-aproved {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .badge-empresa-rejected {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .btn-acao {
        padding: 0.4rem 0.8rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-right: 0.3rem;
        margin-bottom: 0.3rem;
        transition: all 0.2s;
    }

    .btn-aprovar {
        background: #28a745;
        color: white;
    }

        .btn-aprovar:hover {
            background: #218838;
        }

    .btn-rejeitar {
        background: #dc3545;
        color: white;
    }

        .btn-rejeitar:hover {
            background: #c82333;
        }

    .avaliacao-texto {
        color: var(--color-gray);
        font-size: 0.85rem;
        max-width: 200px;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .sem-candidatos {
        text-align: center;
        padding: 3rem;
        background: var(--color-card-bg);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
    }

    .info-aluno small {
        display: block;
        margin-top: 0.3rem;
    }

    /* ✅ MODAL DE EMAIL */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        backdrop-filter: blur(4px);
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-content {
        background: var(--color-dark-gray);
        border: 2px solid var(--color-navy);
        border-radius: 16px;
        padding: 2rem;
        max-width: 600px;
        width: 90%;
        max-height: 80vh;
        overflow-y: auto;
        animation: modalSlideIn 0.3s ease;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--color-navy);
    }

        .modal-header h3 {
            color: var(--color-blue);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .modal-close {
        background: none;
        border: none;
        color: var(--color-gray);
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.2rem;
        transition: color 0.2s;
    }

        .modal-close:hover {
            color: var(--color-danger);
        }

    .modal-info {
        background: var(--color-navy);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

        .modal-info p {
            margin: 0.3rem 0;
            color: var(--color-gray);
        }

        .modal-info strong {
            color: var(--color-white);
        }

    .modal-form .form-group {
        margin-bottom: 1.5rem;
    }

    .modal-form label {
        display: block;
        color: var(--color-gray);
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .modal-form textarea {
        width: 100%;
        padding: 0.75rem 1rem;
        background: var(--color-black);
        border: 1px solid var(--color-navy);
        border-radius: 8px;
        color: var(--color-white);
        font-size: 1rem;
        resize: vertical;
        min-height: 120px;
        font-family: inherit;
    }

        .modal-form textarea:focus {
            outline: none;
            border-color: var(--color-blue);
        }

    .modal-form small {
        color: var(--color-gray);
        font-size: 0.8rem;
        margin-top: 0.3rem;
        display: block;
    }

    .modal-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

        .modal-actions button,
        .modal-actions a {
            flex: 1;
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
            border: none;
            transition: all 0.2s;
        }

    .btn-modal-aprovar {
        background: #28a745;
        color: white;
    }

        .btn-modal-aprovar:hover {
            background: #218838;
        }

    .btn-modal-cancelar {
        background: transparent;
        color: var(--color-gray);
        border: 1px solid var(--color-navy);
    }

        .btn-modal-cancelar:hover {
            border-color: var(--color-danger);
            color: var(--color-danger);
        }

    @@media (max-width: 768px) {
        .candidatos-wrapper {
            flex-direction: column;
            padding: 1rem;
        }

        .candidatos-sidebar {
            width: 100%;
        }

        .modal-content {
            padding: 1.5rem;
            width: 95%;
        }
    }
</style>

<div class="candidatos-wrapper">
    <div class="candidatos-sidebar">
        <div class="menu-card">
            <h3 class="menu-title"><i class="fas fa-th-large"></i> Menu</h3>
            <a href="/Empresa/Dashboard" class="menu-link">
                <i class="fas fa-home"></i> Dashboard
            </a>
            <a href="/Empresa/MinhasOfertas" class="menu-link active">
                <i class="fas fa-briefcase"></i> Minhas Ofertas
            </a>
            <a href="/Empresa/CriarOferta" class="menu-link">
                <i class="fas fa-plus-circle"></i> Nova Oferta
            </a>
        </div>
    </div>

    <div class="candidatos-main">
        <div class="candidatos-header">
            <h2 style="color: var(--color-blue); margin: 0;">
                <i class="fas fa-users"></i> Candidatos: @oferta?.Titulo
            </h2>
            <a href="/Empresa/MinhasOfertas" class="btn btn-outline">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="sem-candidatos">
                <i class="fas fa-inbox" style="font-size: 3rem; color: var(--color-gray); margin-bottom: 1rem;"></i>
                <h3 style="color: var(--color-gray);">Nenhum candidato</h3>
                <p style="color: var(--color-gray);">Ainda não existem candidatos aprovados pelo professor para esta oferta.</p>
            </div>
        }
        else
        {
            <div class="candidatos-table-card">
                <table class="candidatos-table">
                    <thead>
                        <tr>
                            <th>Aluno</th>
                            <th>Data</th>
                            <th>Avaliação Professor</th>
                            <th>Decisão Empresa</th>
                            <th>CV / Ficheiros</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cand in Model)
                        {
                            var empresaDecidiu = cand.Id_Estado_Candidatura_Empresa == 3 || cand.Id_Estado_Candidatura_Empresa == 4;
                            var empresaAprovou = cand.Id_Estado_Candidatura_Empresa == 3;
                            var empresaRejeitou = cand.Id_Estado_Candidatura_Empresa == 4;

                            <tr>
                                <td class="info-aluno">
                                    <strong style="color: var(--color-white);">@cand.Aluno?.Utilizador?.Nome</strong>
                                    <small style="color: var(--color-gray);">
                                        <i class="fas fa-envelope"></i> @cand.Aluno?.Utilizador?.Email
                                    </small>
                                    <small style="color: var(--color-gray);">
                                        <i class="fas fa-graduation-cap"></i> @cand.Aluno?.Curso
                                    </small>
                                    @if (cand.Aluno?.Turma != null)
                                    {
                                        <small style="color: var(--color-blue);">
                                            <i class="fas fa-users"></i> Turma: @cand.Aluno.Turma.Designacao
                                        </small>
                                    }
                                    @if (!string.IsNullOrEmpty(cand.Aluno?.Numero_Aluno))
                                    {
                                        <small style="color: #28a745;">
                                            <i class="fas fa-hashtag"></i> Nº Aluno: @cand.Aluno.Numero_Aluno
                                        </small>
                                    }
                                </td>
                                <td style="white-space: nowrap;">@cand.Data_Candidatura.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (cand.Avaliacoes?.Any() == true)
                                    {
                                        var aval = cand.Avaliacoes.First();
                                        <span class="badge badge-prof-aproved">
                                            <i class="fas fa-check"></i> @aval.DecisaoAvaliacao?.Designacao
                                        </span>
                                        @if (!string.IsNullOrEmpty(aval.Comentarios))
                                        {
                                            <div class="avaliacao-texto">@aval.Comentarios</div>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray);">-</span>
                                    }
                                </td>
                                <td>
                                    @if (empresaAprovou)
                                    {
                                        <span class="badge badge-empresa-aproved">
                                            <i class="fas fa-check-circle"></i> Aprovada pela Empresa
                                        </span>
                                    }
                                    else if (empresaRejeitou)
                                    {
                                        <span class="badge badge-empresa-rejected">
                                            <i class="fas fa-times-circle"></i> Rejeitada pela Empresa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-empresa-pendente">
                                            <i class="fas fa-clock"></i> Pendente (Empresa)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (cand.Ficheiros?.Any() == true)
                                    {
                                        <div class="ficheiros-lista">
                                            @foreach (var ficheiro in cand.Ficheiros)
                                            {
                                                <a href="@ficheiro.Caminho_Ficheiro" target="_blank" class="ficheiro-btn">
                                                    <i class="fas fa-file"></i> @ficheiro.Nome_Ficheiro
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray);">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!empresaDecidiu)
                                    {
                                        <!-- ✅ BOTÃO APROVAR ABRE MODAL -->
                                        <button type="button" class="btn-acao btn-aprovar"
                                                onclick="abrirModalAprovar(@cand.Id, '@cand.Aluno?.Utilizador?.Nome', '@cand.Oferta?.Titulo')">
                                            <i class="fas fa-check"></i> Aprovar Candidato
                                        </button>

                                        <form method="post" asp-action="RejeitarCandidatoEmpresa" style="display: inline;" onsubmit="var motivo = prompt('Motivo da rejeição:'); if(!motivo) return false; this.querySelector('input[name=motivo]').value = motivo;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cand.Id" />
                                            <input type="hidden" name="motivo" value="" />
                                            <button type="submit" class="btn-acao btn-rejeitar">
                                                <i class="fas fa-times"></i> Rejeitar Candidato
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray); font-size: 0.85rem;">
                                            <i class="fas fa-lock"></i> Decisão finalizada
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ✅ MODAL DE APROVAÇÃO COM EMAIL -->
<div class="modal-overlay" id="modalAprovar">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fas fa-envelope-open-text"></i> Aprovar Candidato</h3>
            <button type="button" class="modal-close" onclick="fecharModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="modal-info">
            <p><i class="fas fa-user"></i> <strong>Aluno:</strong> <span id="modalAlunoNome"></span></p>
            <p><i class="fas fa-briefcase"></i> <strong>Oferta:</strong> <span id="modalOfertaTitulo"></span></p>
        </div>

        <form method="post" asp-action="AprovarCandidatoEmpresa" class="modal-form" id="formAprovar">
            <div class="modal-form" id="formAprovar">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalCandidaturaId" />

                <div class="form-group">
                    <label for="mensagemEmail">
                        <i class="fas fa-comment-alt"></i> Mensagem para o aluno <span style="color: var(--color-danger);">*</span>
                    </label>
                    <textarea name="mensagemEmail" id="mensagemEmail" required minlength="10"
                              placeholder="Escreva uma mensagem personalizada ao aluno...&#10;Ex: Parabéns! Foi selecionado para uma entrevista. Entraremos em contacto em breve."></textarea>
                    <small style="color: var(--color-danger);"><i class="fas fa-exclamation-circle"></i> Obrigatório — mínimo 10 caracteres</small>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-modal-aprovar" onclick="validarEEnviar()">
                        <i class="fas fa-paper-plane"></i> Aprovar e Enviar
                    </button>
                    <button type="button" class="btn-modal-cancelar" onclick="fecharModal()">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    var candidaturaIdAtual = null;

    // ABRIR MODAL
    function abrirModalAprovar(candidaturaId, alunoNome, ofertaTitulo) {
        candidaturaIdAtual = candidaturaId;
        document.getElementById('modalCandidaturaId').value = candidaturaId;
        document.getElementById('modalAlunoNome').textContent = alunoNome || 'Aluno';
        document.getElementById('modalOfertaTitulo').textContent = ofertaTitulo || 'Oferta';
        document.getElementById('mensagemEmail').value = '';

        document.getElementById('modalAprovar').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    // FECHAR MODAL
    function fecharModal() {
        document.getElementById('modalAprovar').classList.remove('active');
        document.body.style.overflow = '';
        candidaturaIdAtual = null;
    }

    // ✅ VALIDAR E ENVIAR (email obrigatório)
    function validarEEnviar() {
        var mensagem = document.getElementById('mensagemEmail').value.trim();

        if (!mensagem || mensagem.length < 10) {
            alert('É obrigatório escrever uma mensagem de email com pelo menos 10 caracteres.');
            document.getElementById('mensagemEmail').focus();
            return;
        }

        // Criar form dinamicamente e submeter
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '/Empresa/AprovarCandidatoEmpresa';

        // AntiForgeryToken
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '__RequestVerificationToken';
        tokenInput.value = token;
        form.appendChild(tokenInput);

        // ID da candidatura
        var idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'id';
        idInput.value = candidaturaIdAtual;
        form.appendChild(idInput);

        // Mensagem
        var msgInput = document.createElement('input');
        msgInput.type = 'hidden';
        msgInput.name = 'mensagemEmail';
        msgInput.value = mensagem;
        form.appendChild(msgInput);

        document.body.appendChild(form);
        form.submit();
    }

    // FECHAR AO CLICAR FORA
    document.getElementById('modalAprovar').addEventListener('click', function (e) {
        if (e.target === this) {
            fecharModal();
        }
    });

    // FECHAR COM ESC
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            fecharModal();
        }
    });
</script>