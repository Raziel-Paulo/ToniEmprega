﻿@* Views/Empresa/Candidatos.cshtml *@
@model IEnumerable<ToniEmprega.Models.Candidatura>
@{
    ViewData["Title"] = "Candidatos";
    var oferta = ViewBag.Oferta as Oferta;
}

<style>
    .candidatos-wrapper {
        display: flex;
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .candidatos-sidebar {
        width: 250px;
        flex-shrink: 0;
    }

        .candidatos-sidebar .menu-card {
            background: var(--color-card-bg);
            border: 1px solid var(--color-navy);
            border-radius: 12px;
            padding: 1.5rem;
        }

        .candidatos-sidebar .menu-title {
            color: var(--color-blue);
            margin-bottom: 1.5rem;
            font-size: 1.2rem;
        }

        .candidatos-sidebar .menu-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--color-gray);
            text-decoration: none;
            margin-bottom: 0.5rem;
            transition: all 0.2s;
        }

            .candidatos-sidebar .menu-link:hover {
                background: var(--color-navy);
                color: var(--color-blue);
            }

            .candidatos-sidebar .menu-link.active {
                background: var(--color-navy);
                color: var(--color-blue);
            }

    .candidatos-main {
        flex: 1;
        min-width: 0;
    }

    .candidatos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .candidatos-table-card {
        background: var(--color-card-bg);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
        padding: 1.5rem;
        overflow-x: auto;
    }

    .candidatos-table {
        width: 100%;
        border-collapse: collapse;
    }

        .candidatos-table th {
            text-align: left;
            padding: 1rem;
            color: var(--color-blue);
            border-bottom: 2px solid var(--color-navy);
            white-space: nowrap;
        }

        .candidatos-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--color-navy);
            vertical-align: top;
        }

        .candidatos-table tr:last-child td {
            border-bottom: none;
        }

    .ficheiros-lista {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .ficheiro-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.8rem;
        background: transparent;
        border: 1px solid var(--color-blue);
        color: var(--color-blue);
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.85rem;
        white-space: nowrap;
        transition: all 0.2s;
    }

        .ficheiro-btn:hover {
            background: var(--color-blue);
            color: var(--color-white);
        }

    .badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge-prof-aproved {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .badge-empresa-pendente {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .badge-empresa-aproved {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .badge-empresa-rejected {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .btn-acao {
        padding: 0.4rem 0.8rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-right: 0.3rem;
        margin-bottom: 0.3rem;
    }

    .btn-aprovar {
        background: #28a745;
        color: white;
    }

    .btn-rejeitar {
        background: #dc3545;
        color: white;
    }

    .avaliacao-texto {
        color: var(--color-gray);
        font-size: 0.85rem;
        max-width: 200px;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .sem-candidatos {
        text-align: center;
        padding: 3rem;
        background: var(--color-card-bg);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
    }

    .info-aluno small {
        display: block;
        margin-top: 0.3rem;
    }
</style>

<div class="candidatos-wrapper">
    <div class="candidatos-sidebar">
        <div class="menu-card">
            <h3 class="menu-title"><i class="fas fa-th-large"></i> Menu</h3>
            <a href="/Empresa/Dashboard" class="menu-link">
                <i class="fas fa-home"></i> Dashboard
            </a>
            <a href="/Empresa/MinhasOfertas" class="menu-link active">
                <i class="fas fa-briefcase"></i> Minhas Ofertas
            </a>
            <a href="/Empresa/CriarOferta" class="menu-link">
                <i class="fas fa-plus-circle"></i> Nova Oferta
            </a>
        </div>
    </div>

    <div class="candidatos-main">
        <div class="candidatos-header">
            <h2 style="color: var(--color-blue); margin: 0;">
                <i class="fas fa-users"></i> Candidatos: @oferta?.Titulo
            </h2>
            <a href="/Empresa/MinhasOfertas" class="btn btn-outline">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="sem-candidatos">
                <i class="fas fa-inbox" style="font-size: 3rem; color: var(--color-gray); margin-bottom: 1rem;"></i>
                <h3 style="color: var(--color-gray);">Nenhum candidato</h3>
                <p style="color: var(--color-gray);">Ainda não existem candidatos aprovados pelo professor para esta oferta.</p>
            </div>
        }
        else
        {
            <div class="candidatos-table-card">
                <table class="candidatos-table">
                    <thead>
                        <tr>
                            <th>Aluno</th>
                            <th>Data</th>
                            <th>Avaliação Professor</th>
                            <th>Decisão Empresa</th>
                            <th>CV / Ficheiros</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cand in Model)
                        {
                            // ✅ CORRIGIDO: Usar Id_Estado_Candidatura_Empresa
                            var empresaDecidiu = cand.Id_Estado_Candidatura_Empresa == 3 || cand.Id_Estado_Candidatura_Empresa == 4;
                            var empresaAprovou = cand.Id_Estado_Candidatura_Empresa == 3;
                            var empresaRejeitou = cand.Id_Estado_Candidatura_Empresa == 4;

                            <tr>
                                <td class="info-aluno">
                                    <strong style="color: var(--color-white);">@cand.Aluno?.Utilizador?.Nome</strong>
                                    <small style="color: var(--color-gray);">
                                        <i class="fas fa-envelope"></i> @cand.Aluno?.Utilizador?.Email
                                    </small>
                                    <small style="color: var(--color-gray);">
                                        <i class="fas fa-graduation-cap"></i> @cand.Aluno?.Curso
                                    </small>
                                </td>
                                <td style="white-space: nowrap;">@cand.Data_Candidatura.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (cand.Avaliacoes?.Any() == true)
                                    {
                                        var aval = cand.Avaliacoes.First();
                                        <span class="badge badge-prof-aproved">
                                            <i class="fas fa-check"></i> @aval.DecisaoAvaliacao?.Designacao
                                        </span>
                                        @if (!string.IsNullOrEmpty(aval.Comentarios))
                                        {
                                            <div class="avaliacao-texto">@aval.Comentarios</div>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray);">-</span>
                                    }
                                </td>
                                <td>
                                    @if (empresaAprovou)
                                    {
                                        <span class="badge badge-empresa-aproved">
                                            <i class="fas fa-check-circle"></i> Aprovada pela Empresa
                                        </span>
                                    }
                                    else if (empresaRejeitou)
                                    {
                                        <span class="badge badge-empresa-rejected">
                                            <i class="fas fa-times-circle"></i> Rejeitada pela Empresa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-empresa-pendente">
                                            <i class="fas fa-clock"></i> Pendente (Empresa)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (cand.Ficheiros?.Any() == true)
                                    {
                                        <div class="ficheiros-lista">
                                            @foreach (var ficheiro in cand.Ficheiros)
                                            {
                                                <a href="@ficheiro.Caminho_Ficheiro" target="_blank" class="ficheiro-btn">
                                                    <i class="fas fa-file"></i> @ficheiro.Nome_Ficheiro
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray);">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!empresaDecidiu)
                                    {
                                        <form method="post" asp-action="AprovarCandidatoEmpresa" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cand.Id" />
                                            <button type="submit" class="btn-acao btn-aprovar">
                                                <i class="fas fa-check"></i> Aprovar Candidato
                                            </button>
                                        </form>
                                        <form method="post" asp-action="RejeitarCandidatoEmpresa" style="display: inline;" onsubmit="var motivo = prompt('Motivo da rejeição:'); if(!motivo) return false; this.querySelector('input[name=motivo]').value = motivo;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cand.Id" />
                                            <input type="hidden" name="motivo" value="" />
                                            <button type="submit" class="btn-acao btn-rejeitar">
                                                <i class="fas fa-times"></i> Rejeitar Candidato
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray); font-size: 0.85rem;">
                                            <i class="fas fa-lock"></i> Decisão finalizada
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>