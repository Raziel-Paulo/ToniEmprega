@model ToniEmprega.Models.Empresa
@{
    ViewData["Title"] = "Perfil da Empresa";
}

<div class="dashboard-grid">
    <aside class="sidebar">
        <h3 style="color: #1E90FF;"><i class="fas fa-building"></i> Menu</h3>
        <ul class="sidebar-menu">
            <li><a href="/Empresa/Dashboard" class="sidebar-link"><i class="fas fa-home"></i> Dashboard</a></li>
            <li><a href="/Empresa/Perfil" class="sidebar-link active"><i class="fas fa-id-card"></i> Perfil</a></li>
            <li><a href="/Empresa/MinhasOfertas" class="sidebar-link"><i class="fas fa-briefcase"></i> Minhas Ofertas</a></li>
            <li><a href="/Empresa/CriarOferta" class="sidebar-link"><i class="fas fa-plus-circle"></i> Nova Oferta</a></li>
        </ul>
    </aside>

    <div>
        <h2 style="color: #1E90FF; margin-bottom: 1.5rem;">
            <i class="fas fa-building"></i> Perfil da Empresa
        </h2>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-info-circle"></i> Informações da Empresa</h3>
            </div>
            <form method="post" asp-action="AtualizarPerfil">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Nome da Empresa</label>
                    <input type="text" name="nomeEmpresa" class="form-control" value="@Model.Nome_Empresa" required />
                </div>
                <div class="form-group">
                    <label class="form-label">NIF</label>
                    <input type="text" name="nif" class="form-control" value="@Model.Nif" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Morada</label>
                    <input type="text" name="morada" class="form-control" value="@Model.Morada" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Telefone</label>
                    <input type="text" name="telefone" class="form-control" value="@Model.Telefone" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Website</label>
                    <input type="url" name="site" class="form-control" value="@Model.Site_Empresa" />
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Guardar Alterações
                </button>
            </form>
        </div>
    </div>
</div>