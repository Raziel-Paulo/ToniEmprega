@* Views/Empresa/Dashboard.cshtml *@
@model IEnumerable<ToniEmprega.Models.Oferta>
@{
    ViewData["Title"] = "Dashboard Empresa";
}

<div class="dashboard-grid">
    <aside class="sidebar">
        <h3 style="color: #1E90FF;"><i class="fas fa-building"></i> Menu</h3>
        <ul class="sidebar-menu">
            <li><a href="/Empresa/Dashboard" class="sidebar-link active"><i class="fas fa-home"></i> Dashboard</a></li>
            <li><a href="/Empresa/MinhasOfertas" class="sidebar-link"><i class="fas fa-briefcase"></i> Minhas Ofertas</a></li>
            <li><a href="/Empresa/CriarOferta" class="sidebar-link"><i class="fas fa-plus-circle"></i> Nova Oferta</a></li>
        </ul>
    </aside>

    <div>
        <h2 style="color: #1E90FF; margin-bottom: 1.5rem;">
            <i class="fas fa-building"></i> Painel da Empresa
        </h2>

        <!-- Estatísticas -->
        <div class="stats-grid">
            <div class="stat-card">
                <i class="fas fa-briefcase stat-icon"></i>
                <span class="stat-number">@ViewBag.TotalOfertas</span>
                <span class="stat-label">Total Ofertas</span>
            </div>
            <div class="stat-card">
                <i class="fas fa-check-circle stat-icon"></i>
                <span class="stat-number">@ViewBag.OfertasAtivas</span>
                <span class="stat-label">Ativas</span>
            </div>
            <div class="stat-card">
                <i class="fas fa-users stat-icon"></i>
                <span class="stat-number">@ViewBag.TotalCandidaturas</span>
                <span class="stat-label">Candidaturas</span>
            </div>
            <div class="stat-card">
                <i class="fas fa-clock stat-icon"></i>
                <span class="stat-number">@ViewBag.CandidaturasPendentes</span>
                <span class="stat-label">Pendentes</span>
            </div>
        </div>

        <!-- Ofertas Recentes -->
        <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h3 class="card-title"><i class="fas fa-fire"></i> Ofertas Recentes</h3>
                <a href="/Empresa/CriarOferta" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Nova
                </a>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th>Candidaturas</th>
                                <th>Data</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var oferta in Model)
                            {
                                <tr>
                                    <td><strong>@oferta.Titulo</strong></td>
                                    <td>
                                        <span class="oferta-tipo">@oferta.TipoOferta?.Designacao</span>
                                    </td>
                                    <td>
                                        <span class="badge @(oferta.Id_Estado_Oferta == 1 ? "badge-approved" :
                                                                                                             oferta.Id_Estado_Oferta == 4 ? "badge-rejected" : "badge-pending")">
                                    @oferta.EstadoOferta?.Designacao
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <span class="badge badge-pending">
                                    @(oferta.Candidaturas?.Count ?? 0)
                                </span>
                            </td>
                            <td>@oferta.Data_Publicacao.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="/Empresa/Candidatos/@oferta.Id" class="btn btn-outline btn-sm">
                                    <i class="fas fa-users"></i> Ver
                                </a>
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>

                @if (Model.Count() == 5 && ViewBag.TotalOfertas > 5)
                {
                    <div style="text-align: center; margin-top: 1rem;">
                        <a href="/Empresa/MinhasOfertas" class="btn btn-outline">
                            Ver Todas as Ofertas <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 3rem; color: var(--color-gray);">
                    <i class="fas fa-briefcase" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                    <h3>Ainda não criou nenhuma oferta</h3>
                    <p>Comece por criar a sua primeira oferta de emprego ou estágio.</p>
                    <a href="/Empresa/CriarOferta" class="btn btn-primary" style="margin-top: 1rem;">
                        <i class="fas fa-plus"></i> Criar Oferta
                    </a>
                </div>
            }
        </div>

        <!-- Notificações Recentes -->
        @if (ViewBag.Notificacoes != null && ViewBag.Notificacoes.Count > 0)
        {
            <div class="card" style="margin-top: 2rem;">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-bell"></i> Notificações Recentes</h3>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    @foreach (var notif in ViewBag.Notificacoes)
                    {
                        <div style="padding: 0.75rem; background-color: var(--color-black); border-radius: 6px; border-left: 3px solid var(--color-blue);">
                            <strong style="color: var(--color-white);">@notif.Titulo</strong>
                            <p style="color: var(--color-gray); margin: 0.25rem 0 0 0; font-size: 0.9rem;">@notif.Mensagem</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>