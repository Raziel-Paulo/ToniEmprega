@model ToniEmprega.Models.Oferta
@{
    ViewData["Title"] = "Nova Oferta";
}

<div style="max-width: 900px; margin: 0 auto;">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title"><i class="fas fa-plus-circle"></i> Criar Oferta</h2>
        </div>

        <div asp-validation-summary="All" class="alert alert-error" style="margin: 1rem 0; display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <form method="post" action="/Empresa/CriarOferta" id="formOferta">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Título <span style="color: var(--color-danger);">*</span></label>
                <input type="text" name="Titulo" class="form-control" required
                       value="@(Model?.Titulo ?? "")"
                       placeholder="Ex: Estágio em Desenvolvimento Web"
                       minlength="5" maxlength="200" />
                <small style="color: var(--color-gray);">Mínimo 5 caracteres</small>
            </div>

            <div class="form-group">
                <label class="form-label">Tipo <span style="color: var(--color-danger);">*</span></label>
                <select name="Id_Tipo_Oferta" class="form-control" required>
                    <option value="">-- Selecione --</option>
                    @if (ViewBag.TiposOferta != null)
                    {
                        @foreach (var tipo in ViewBag.TiposOferta)
                        {
                            <option value="@tipo.Id">@tipo.Designacao</option>
                        }
                    }
                </select>
            </div>

            <!-- 🗺️ NOVO: Localização com Mapa Interativo Leaflet -->
            <div class="form-group">
                <label class="form-label"><i class="fas fa-map-marker-alt"></i> Localização <span style="color: var(--color-danger);">*</span></label>
                
                <!-- Campo de pesquisa -->
                <div class="input-group" style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <input type="text" id="pesquisa-morada" class="form-control" 
                           placeholder="Digite a morada e clique em Pesquisar..."
                           style="flex: 1;" autocomplete="off" />
                    <button type="button" class="btn btn-primary" onclick="pesquisarMorada()">
                        <i class="fas fa-search"></i> Pesquisar
                    </button>
                </div>
                <small style="color: var(--color-gray); display: block; margin-bottom: 0.5rem;">
                    <i class="fas fa-info-circle"></i> Pesquise uma morada ou clique diretamente no mapa para selecionar
                </small>

                <!-- Mapa -->
                <div id="mapa-localizacao" style="width: 100%; height: 350px; border-radius: 8px; border: 2px solid var(--color-navy);"></div>
                
                <!-- Info das coordenadas -->
                <div id="coordenadas-info" style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--color-gray);">
                    <i class="fas fa-hand-pointer"></i> Clique no mapa para selecionar a localização
                </div>

                <!-- Campo da morada (preenchido automaticamente) -->
                <input type="text" id="localizacao" name="Localizacao" class="form-control" required
                       value="@(Model?.Localizacao ?? "")"
                       placeholder="Morada selecionada..."
                       style="margin-top: 0.75rem;" readonly />
                
                <!-- Campos ocultos para coordenadas -->
                <input type="hidden" name="Latitude" id="latitude" value="@(Model?.Latitude?.ToString().Replace(",",".") ?? "")" />
                <input type="hidden" name="Longitude" id="longitude" value="@(Model?.Longitude?.ToString().Replace(",",".") ?? "")" />
            </div>

            <div class="form-group">
                <label class="form-label">Descrição <span style="color: var(--color-danger);">*</span></label>
                <textarea name="Descricao" class="form-control" rows="4" required
                          placeholder="Descreva as funções e responsabilidades..."
                          minlength="20" maxlength="2000">@(Model?.Descricao ?? "")</textarea>
                <small style="color: var(--color-gray);">Mínimo 20 caracteres</small>
            </div>

            <div class="form-group">
                <label class="form-label">Requisitos <span style="color: var(--color-danger);">*</span></label>
                <textarea name="Requisitos" class="form-control" rows="3" required
                          placeholder="Ex: Conhecimentos em C#, SQL, etc."
                          minlength="10" maxlength="1000">@(Model?.Requisitos ?? "")</textarea>
                <small style="color: var(--color-gray);">Mínimo 10 caracteres</small>
            </div>

            <div class="form-group">
                <label class="form-label">Data de Expiração (opcional)</label>
                <input type="date" name="Data_Expiracao" class="form-control"
                       value="@(Model?.Data_Expiracao?.ToString("yyyy-MM-dd") ?? "")"
                       min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                <small style="color: var(--color-gray);">Deixe em branco para não expirar</small>
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Publicar Oferta
                </button>
                <a href="/Empresa/MinhasOfertas" class="btn btn-outline">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<!-- 🗺️ CSS do Leaflet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<!-- 🗺️ JavaScript do Leaflet -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>

<script>
    let mapa;
    let marcador;
    
    // Coordenadas padrão (Portugal - Lisboa)
    const LAT_PADRAO = 38.7223;
    const LNG_PADRAO = -9.1393;

    document.addEventListener('DOMContentLoaded', function() {
        inicializarMapa();
    });

    function inicializarMapa() {
        // Criar o mapa centrado em Portugal
        mapa = L.map('mapa-localizacao').setView([LAT_PADRAO, LNG_PADRAO], 7);

        // Adicionar camada do OpenStreetMap
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(mapa);

        // Evento de clique no mapa
        mapa.on('click', function(e) {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;
            atualizarMarcador(lat, lng);
            obterMoradaPorCoordenadas(lat, lng);
        });
    }

    function atualizarMarcador(lat, lng) {
        // Remover marcador anterior se existir
        if (marcador) {
            mapa.removeLayer(marcador);
        }

        // Criar novo marcador
        marcador = L.marker([lat, lng]).addTo(mapa);
        
        // Animar o marcador
        marcador.bindPopup('<b>Local selecionado!</b><br>Lat: ' + lat.toFixed(5) + '<br>Lng: ' + lng.toFixed(5)).openPopup();

        // Atualizar campos ocultos
        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;

        // Mostrar coordenadas
        document.getElementById('coordenadas-info').innerHTML = 
            '<i class="fas fa-check-circle" style="color: #28a745;"></i> <strong>Coordenadas:</strong> ' + 
            lat.toFixed(6) + ', ' + lng.toFixed(6);
    }

    // Pesquisar morada usando Nominatim (OpenStreetMap - GRÁTIS)
    async function pesquisarMorada() {
        const morada = document.getElementById('pesquisa-morada').value.trim();

        if (!morada) {
            alert('Por favor, digite uma morada para pesquisar.');
            return;
        }

        // Mostrar loading
        const btn = document.querySelector('button[onclick="pesquisarMorada()"]');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A pesquisar...';
        btn.disabled = true;

        try {
            const url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + 
                       encodeURIComponent(morada + ', Portugal') + '&limit=1';

            const response = await fetch(url, {
                headers: { 'User-Agent': 'ToniEmprega/1.0' }
            });

            const data = await response.json();

            if (data && data.length > 0) {
                const resultado = data[0];
                const lat = parseFloat(resultado.lat);
                const lng = parseFloat(resultado.lon);

                // Centrar mapa e adicionar marcador
                mapa.setView([lat, lng], 16);
                atualizarMarcador(lat, lng);

                // Preencher morada
                document.getElementById('localizacao').value = resultado.display_name;
                
                // Mostrar sucesso
                document.getElementById('coordenadas-info').innerHTML = 
                    '<i class="fas fa-check-circle" style="color: #28a745;"></i> <strong>Morada encontrada!</strong> ' +
                    lat.toFixed(6) + ', ' + lng.toFixed(6);
            } else {
                alert('Morada não encontrada. Tente ser mais específico ou clique no mapa.');
            }
        } catch (error) {
            console.error('Erro na pesquisa:', error);
            alert('Erro ao pesquisar morada. Verifique a ligação à internet.');
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }

    // Reverse Geocoding: obter morada a partir de coordenadas
    async function obterMoradaPorCoordenadas(lat, lng) {
        try {
            const url = 'https://nominatim.openstreetmap.org/reverse?format=json&lat=' + 
                       lat + '&lon=' + lng + '&zoom=18&addressdetails=1';

            const response = await fetch(url, {
                headers: { 'User-Agent': 'ToniEmprega/1.0' }
            });

            const data = await response.json();

            if (data && data.display_name) {
                document.getElementById('localizacao').value = data.display_name;
            } else {
                document.getElementById('localizacao').value = 'Lat: ' + lat.toFixed(5) + ', Lng: ' + lng.toFixed(5);
            }
        } catch (error) {
            console.error('Erro no reverse geocoding:', error);
            document.getElementById('localizacao').value = 'Lat: ' + lat.toFixed(5) + ', Lng: ' + lng.toFixed(5);
        }
    }

    // Permitir pesquisa ao pressionar Enter
    document.getElementById('pesquisa-morada').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            pesquisarMorada();
        }
    });

    // Validação do formulário antes de submeter
    document.getElementById('formOferta').addEventListener('submit', function(e) {
        const localizacao = document.getElementById('localizacao').value;
        const lat = document.getElementById('latitude').value;
        const lng = document.getElementById('longitude').value;

        if (localizacao.length < 5) {
            e.preventDefault();
            alert('Por favor, selecione uma localização válida no mapa.');
            return false;
        }

        if (!lat || !lng) {
            e.preventDefault();
            alert('Por favor, clique no mapa para selecionar a localização exata.');
            return false;
        }

        return true;
    });
</script>