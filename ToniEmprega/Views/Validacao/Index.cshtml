@model IEnumerable<ToniEmprega.Models.ValidacaoIdentidade>
@{
    ViewData["Title"] = "Validação de Identidade";
    Layout = "_ValidationLayout"; // Usar layout especial sem menu de navegação!
}

<style>
    /* Esconder elementos de navegação quando em validação pendente */
    .nav-menu, .sidebar, .navbar-nav {
        display: none !important;
    }

    .validation-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
    }

    .validation-locked {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.9);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="validation-container">
    <h2 style="color: #1E90FF; margin-bottom: 1.5rem; text-align: center;">
        <i class="fas fa-shield-alt"></i> Validação de Identidade Obrigatória
    </h2>

    @{
        var estadoAtual = ViewBag.EstadoAtual as int?;
    }

    @if (estadoAtual == 1)
    {
        <div class="alert alert-warning" style="margin-bottom: 1.5rem; text-align: center;">
            <i class="fas fa-clock fa-2x" style="display: block; margin-bottom: 1rem;"></i>
            <strong>Aguardando aprovação.</strong><br>
            O seu documento está a ser analisado pelo administrador.<br>
            <small>Não pode aceder à plataforma até ser aprovado.</small>
        </div>

        <!-- Refresh automático para verificar se foi aprovado -->
        <meta http-equiv="refresh" content="30">
    }
    else if (estadoAtual == 2)
    {
        <div class="alert alert-success" style="margin-bottom: 1.5rem;">
            <i class="fas fa-check-circle"></i>
            <strong>Validação aprovada!</strong> A redirecionar...
        </div>
        <script>
            setTimeout(function() {
                window.location.href = '/';
            }, 2000);
        </script>
    }
    else if (estadoAtual == 3 || ViewBag.PrecisaNovaValidacao == true)
    {
        <div class="alert alert-error" style="margin-bottom: 1.5rem;">
            <i class="fas fa-times-circle"></i>
            <strong>Validação rejeitada.</strong> Por favor, submeta novo documento.
        </div>
    }
    else
    {
        <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
            <i class="fas fa-exclamation-circle"></i>
            <strong>Documento pendente.</strong> Submeta o seu documento de identificação para continuar.
        </div>
    }

    <!-- Só mostrar formulário se não estiver aprovado -->
    @if (estadoAtual != 2)
    {
        <div class="card" style="margin-bottom: 2rem;">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-upload"></i> Submeter Documento</h3>
            </div>
            <form method="post" asp-action="Submeter" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Tipo de Documento</label>
                    <select name="tipoValidacaoId" class="form-control" required>
                        @foreach (var tipo in ViewBag.TiposValidacao ?? new List<TipoValidacao>())
                        {
                            <option value="@tipo.Id">@tipo.Designacao</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Documento (PDF ou Imagem)</label>
                    <input type="file" name="documento" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                    <small style="color: var(--color-gray);">
                        Formatos aceites: PDF, JPG, PNG. Máximo 10MB.
                    </small>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-upload"></i> Submeter para Validação
                </button>
            </form>
        </div>

        <div style="text-align: center; margin-top: 2rem;">
            <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline">
                    <i class="fas fa-sign-out-alt"></i> Sair da Conta
                </button>
            </form>
        </div>
    }

    <!-- Histórico -->
    @if (Model.Any())
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-history"></i> Histórico</h3>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Data</th>
                            <th>Documento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var val in Model)
                        {
                            <tr>
                                <td>@val.TipoValidacao?.Designacao</td>
                                <td>
                                    <span class="badge @(val.Id_Estado_Validacao_Documento == 1 ? "badge-pending" :
                                                                                                     val.Id_Estado_Validacao_Documento == 2 ? "badge-approved" : "badge-rejected")">
                                @val.EstadoValidacaoDocumento?.Designacao
                            </span>
                        </td>
                        <td>@(val.Data_Validacao?.ToString("dd/MM/yyyy") ?? "Pendente")</td>
                        <td>
                            <a href="@val.Ficheiro_Prova" target="_blank" class="btn btn-outline btn-sm">
                                <i class="fas fa-eye"></i> Ver
                            </a>
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>