@* Views/Validacao/Index.cshtml - MODIFICADO *@
@model ToniEmprega.Models.ValidacaoIdentidade
@{
    ViewData["Title"] = "Validação de Identidade";
    Layout = "_ValidationLayout";
}

<style>
    .documento-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background-color: var(--color-navy);
        border-radius: 8px;
        margin-bottom: 0.5rem;
    }
    
    .documento-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .documento-icon {
        font-size: 2rem;
        color: var(--color-blue);
    }
</style>

<div class="validation-container">
    <h2 style="color: #1E90FF; margin-bottom: 1.5rem; text-align: center;">
        <i class="fas fa-shield-alt"></i> Validação de Identidade Obrigatória
    </h2>

    @{
        var estadoAtual = ViewBag.EstadoAtual as int?;
        var documentos = Model?.Documentos ?? new List<DocumentoValidacao>();
    }

    @if (estadoAtual == 1)
    {
        <div class="alert alert-warning" style="margin-bottom: 1.5rem; text-align: center;">
            <i class="fas fa-clock fa-2x" style="display: block; margin-bottom: 1rem;"></i>
            <strong>Aguardando aprovação.</strong><br>
            O seu documento está a ser analisado pelo administrador.<br>
            <small>Não pode aceder à plataforma até ser aprovado.</small>
        </div>
        <meta http-equiv="refresh" content="30">
    }
    else if (estadoAtual == 2)
    {
        <div class="alert alert-success" style="margin-bottom: 1.5rem;">
            <i class="fas fa-check-circle"></i>
            <strong>Validação aprovada!</strong> A redirecionar...
        </div>
        <script>
                setTimeout(function() {
                    window.location.href = '/';
                }, 2000);
        </script>
    }
    else if (estadoAtual == 3 || ViewBag.PrecisaNovaValidacao == true)
    {
        <div class="alert alert-error" style="margin-bottom: 1.5rem;">
            <i class="fas fa-times-circle"></i>
            <strong>Validação rejeitada.</strong><br>
            @if (!string.IsNullOrEmpty(ViewBag.MotivoRejeicao))
            {
                <small>Motivo: @ViewBag.MotivoRejeicao</small>
            }
            <br>Por favor, submeta novo documento.
        </div>
    }
    else
    {
        <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
            <i class="fas fa-exclamation-circle"></i>
            <strong>Documento pendente.</strong> Submeta o seu documento de identificação para continuar.
        </div>
    }

    @if (estadoAtual != 2)
    {
        <!-- Lista de Documentos Submetidos -->
        @if (documentos.Any())
        {
            <div class="card" style="margin-bottom: 2rem;">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-folder-open"></i> Documentos Submetidos (@documentos.Count)</h3>
                </div>
                
                @foreach (var doc in documentos)
                {
                    <div class="documento-item">
                        <div class="documento-info">
                            <i class="fas fa-file-alt documento-icon"></i>
                            <div>
                                <strong>@doc.Tipo_Documento</strong><br>
                                <small style="color: var(--color-gray);">@doc.Nome_Ficheiro</small><br>
                                <small style="color: var(--color-gray);">@doc.Data_Upload.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                        
                        @if (Model?.Id_Estado_Validacao_Documento == 1)
                        {
                            <form method="post" asp-action="RemoverDocumento" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@doc.Id" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Remover este documento?');">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a href="@doc.Caminho_Ficheiro" target="_blank" class="btn btn-outline btn-sm">
                                <i class="fas fa-eye"></i> Ver
                            </a>
                        }
                    </div>
                }
            </div>
        }

        <!-- Formulário para Adicionar Novo Documento -->
        @if (Model?.Id_Estado_Validacao_Documento == 1 || Model?.Id_Estado_Validacao_Documento == 3 || Model == null)
        {
            <div class="card" style="margin-bottom: 2rem;">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-plus-circle"></i> Adicionar Documento</h3>
                </div>
                <form method="post" asp-action="SubmeterDocumento" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label">Tipo de Documento</label>
                        <select name="tipoDocumento" class="form-control" required>
                            <option value="">Selecione...</option>
                            @foreach (var tipo in ViewBag.TiposDocumento as List<string> ?? new List<string>())
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Documento (PDF ou Imagem)</label>
                        <input type="file" name="documento" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                        <small style="color: var(--color-gray);">
                            Formatos aceites: PDF, JPG, PNG. Máximo 10MB.
                        </small>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        <i class="fas fa-upload"></i> Adicionar Documento
                    </button>
                </form>
            </div>
        }

        <div style="text-align: center; margin-top: 2rem;">
            <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline">
                    <i class="fas fa-sign-out-alt"></i> Sair da Conta
                </button>
            </form>
        </div>
    }
</div>