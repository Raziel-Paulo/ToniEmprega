@* Views/Aluno/Candidatar.cshtml *@
@{
    ViewData["Title"] = "Candidatar-se";
    var oferta = ViewBag.Oferta as Oferta;
}

<style>
    .candidatura-page {
        max-width: 700px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .candidatura-card {
        background: var(--color-dark-gray);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
        padding: 2rem;
    }

    .candidatura-header {
        background: var(--color-navy);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .candidatura-header h3 {
            color: var(--color-blue);
            margin: 0 0 0.5rem 0;
        }

        .candidatura-header p {
            color: var(--color-gray);
            margin: 0;
        }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        color: var(--color-gray);
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

        .form-label .required {
            color: var(--color-danger);
        }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        background: var(--color-black);
        border: 1px solid var(--color-navy);
        border-radius: 8px;
        color: var(--color-white);
        font-size: 1rem;
        transition: border-color 0.3s;
        resize: vertical;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--color-blue);
            box-shadow: 0 0 0 3px rgba(30, 144, 255, 0.1);
        }

        .form-control.error {
            border-color: var(--color-danger);
        }

    .char-counter {
        text-align: right;
        color: var(--color-gray);
        font-size: 0.8rem;
        margin-top: 0.3rem;
    }

        .char-counter .min-reached {
            color: var(--color-success);
        }

        .char-counter .min-not-reached {
            color: var(--color-warning);
        }

    .file-input-wrapper {
        position: relative;
        margin-bottom: 0.5rem;
    }

    .file-input {
        display: none;
    }

    .file-label {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        background: var(--color-navy);
        color: var(--color-blue);
        border: 1px solid var(--color-blue);
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .file-label:hover {
            background: var(--color-blue);
            color: var(--color-white);
        }

    .file-list {
        margin-top: 1rem;
    }

    .file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 1rem;
        background: var(--color-black);
        border: 1px solid var(--color-navy);
        border-radius: 6px;
        margin-bottom: 0.5rem;
    }

        .file-item .file-name {
            color: var(--color-white);
            font-size: 0.9rem;
        }

        .file-item .file-size {
            color: var(--color-gray);
            font-size: 0.8rem;
        }

        .file-item .remove-file {
            background: none;
            border: none;
            color: var(--color-danger);
            cursor: pointer;
            font-size: 1rem;
            padding: 0.2rem;
        }

            .file-item .remove-file:hover {
                color: #ff4444;
            }

    .btn-add-file {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: transparent;
        color: var(--color-blue);
        border: 1px dashed var(--color-blue);
        border-radius: 6px;
        cursor: pointer;
        margin-top: 0.5rem;
        transition: all 0.2s;
    }

        .btn-add-file:hover {
            background: rgba(30, 144, 255, 0.1);
        }

        .btn-add-file:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .info-text {
        color: var(--color-gray);
        font-size: 0.85rem;
        margin-top: 0.5rem;
    }

        .info-text i {
            color: var(--color-blue);
        }

    .error-message {
        color: var(--color-danger);
        font-size: 0.85rem;
        margin-top: 0.3rem;
        display: none;
    }

        .error-message.show {
            display: block;
        }

    .btn-submit {
        width: 100%;
        padding: 0.8rem;
        background: var(--color-blue);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-submit:hover:not(:disabled) {
            background: #1873cc;
            transform: translateY(-2px);
        }

        .btn-submit:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        background: transparent;
        color: var(--color-gray);
        border: 1px solid var(--color-navy);
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            border-color: var(--color-blue);
            color: var(--color-blue);
        }

    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .validation-summary {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid var(--color-danger);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
        color: var(--color-danger);
    }
</style>

<div class="candidatura-page">
    <div class="candidatura-card">
        <div class="candidatura-header">
            <h3><i class="fas fa-briefcase"></i> @oferta?.Titulo</h3>
            <p><i class="fas fa-building"></i> @oferta?.Empresa?.Nome_Empresa</p>
        </div>

        <form asp-action="Candidatar" method="post" enctype="multipart/form-data" id="candidaturaForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ofertaId" value="@oferta?.Id" />

            <!-- Mensagem de Motivação -->
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-comment"></i> Mensagem de Motivação <span class="required">*</span>
                </label>
                <textarea name="mensagem" id="mensagem" class="form-control" rows="6"
                          placeholder="Explica porque te candidatas a esta oferta... (mínimo 50 caracteres)"
                          minlength="50" required></textarea>
                <div class="char-counter" id="charCounter">
                    <span id="charCount">0</span> / 50 caracteres mínimos
                </div>
                <div class="error-message" id="mensagemError">A mensagem deve ter pelo menos 50 caracteres.</div>
            </div>

            <!-- Ficheiros -->
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-paperclip"></i> Anexar Ficheiros (CV, Carta de Apresentação) <span class="required">*</span>
                </label>

                <div id="fileInputsContainer">
                    <div class="file-input-wrapper">
                        <input type="file" name="ficheiros" id="ficheiro_0" class="file-input"
                               accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                        <label for="ficheiro_0" class="file-label">
                            <i class="fas fa-upload"></i> Escolher ficheiro
                        </label>
                    </div>
                </div>

                <button type="button" class="btn-add-file" id="btnAddFile" onclick="addFileInput()">
                    <i class="fas fa-plus"></i> Adicionar outro ficheiro
                </button>

                <div class="file-list" id="fileList"></div>

                <div class="info-text">
                    <i class="fas fa-info-circle"></i>
                    Formatos aceites: PDF, DOC, DOCX. Tamanho máximo: 5MB por ficheiro. Máximo 3 ficheiros.
                </div>
                <div class="error-message" id="ficheirosError">É obrigatório anexar pelo menos 1 ficheiro.</div>
            </div>

            <!-- Ações -->
            <div class="actions">
                <button type="submit" class="btn-submit" id="btnSubmit" disabled>
                    <i class="fas fa-paper-plane"></i> Submeter Candidatura
                </button>
                <a href="/Ofertas" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    let fileCount = 0;
    const maxFiles = 3;
    const maxFileSize = 5 * 1024 * 1024; // 5MB
    const allowedTypes = [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
    ];
    const allowedExtensions = ['.pdf', '.doc', '.docx'];

    const mensagemInput = document.getElementById('mensagem');
    const charCounter = document.getElementById('charCounter');
    const charCount = document.getElementById('charCount');
    const btnSubmit = document.getElementById('btnSubmit');
    const fileList = document.getElementById('fileList');
    const btnAddFile = document.getElementById('btnAddFile');

    // Validar mensagem
    mensagemInput.addEventListener('input', function() {
        const len = this.value.length;
        charCount.textContent = len;
        if (len >= 50) {
            charCounter.classList.remove('min-not-reached');
            charCounter.classList.add('min-reached');
            this.classList.remove('error');
            document.getElementById('mensagemError').classList.remove('show');
        } else {
            charCounter.classList.remove('min-reached');
            charCounter.classList.add('min-not-reached');
        }
        validateForm();
    });

    // Adicionar input de ficheiro
    function addFileInput() {
        if (fileCount >= maxFiles - 1) return;

        fileCount++;
        const container = document.getElementById('fileInputsContainer');
        const wrapper = document.createElement('div');
        wrapper.className = 'file-input-wrapper';
        wrapper.innerHTML = `
            <input type="file" name="ficheiros" id="ficheiro_${fileCount}" class="file-input"
                   accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            <label for="ficheiro_${fileCount}" class="file-label">
                <i class="fas fa-upload"></i> Escolher ficheiro
            </label>
        `;
        container.appendChild(wrapper);

        // Bind evento ao novo input
        const newInput = document.getElementById(`ficheiro_${fileCount}`);
        newInput.addEventListener('change', handleFileSelect);

        if (fileCount >= maxFiles - 1) {
            btnAddFile.disabled = true;
            btnAddFile.style.opacity = '0.5';
        }
    }

    // Handler de seleção de ficheiro
    function handleFileSelect(e) {
        const file = e.target.files[0];
        if (!file) return;

        // Validar tipo
        const ext = '.' + file.name.split('.').pop().toLowerCase();
        if (!allowedExtensions.includes(ext) && !allowedTypes.includes(file.type)) {
            alert('Tipo de ficheiro não permitido. Use apenas PDF, DOC ou DOCX.');
            e.target.value = '';
            return;
        }

        // Validar tamanho
        if (file.size > maxFileSize) {
            alert('Ficheiro demasiado grande (máximo 5MB).');
            e.target.value = '';
            return;
        }

        updateFileList();
        validateForm();
    }

    // Atualizar lista de ficheiros
    function updateFileList() {
        fileList.innerHTML = '';
        const inputs = document.querySelectorAll('input[name=\"ficheiros\"]');
        let validFiles = 0;

        inputs.forEach((input, index) => {
            if (input.files && input.files[0]) {
                validFiles++;
                const file = input.files[0];
                const size = (file.size / 1024 / 1024).toFixed(2);
                const item = document.createElement('div');
                item.className = 'file-item';
                item.innerHTML = `
                    <div>
                        <span class="file-name\"><i class=\"fas fa-file\"></i> ${file.name}</span>
                        <span class=\"file-size\">(${size} MB)</span>
                    </div>
                    <button type=\"button\" class=\"remove-file\" onclick=\"removeFile(${index})\" title=\"Remover\">
                        <i class=\"fas fa-trash\"></i>
                    </button>
                `;
                fileList.appendChild(item);
            }
        });

        if (validFiles > 0) {
            document.getElementById('ficheirosError').classList.remove('show');
        }

        return validFiles;
    }

    // Remover ficheiro
    function removeFile(index) {
        const inputs = document.querySelectorAll('input[name=\"ficheiros\"]');
        if (inputs[index]) {
            inputs[index].value = '';
            updateFileList();
            validateForm();
        }
    }

    // Validar formulário completo
    function validateForm() {
        const mensagemOk = mensagemInput.value.length >= 50;
        const filesOk = updateFileList() > 0;

        btnSubmit.disabled = !(mensagemOk && filesOk);
    }

    // Bind inicial
    document.getElementById('ficheiro_0').addEventListener('change', handleFileSelect);

    // Validar no submit
    document.getElementById('candidaturaForm').addEventListener('submit', function(e) {
        const mensagemOk = mensagemInput.value.length >= 50;
        const filesOk = updateFileList() > 0;

        if (!mensagemOk) {
            e.preventDefault();
            mensagemInput.classList.add('error');
            document.getElementById('mensagemError').classList.add('show');
            mensagemInput.focus();
            return false;
        }

        if (!filesOk) {
            e.preventDefault();
            document.getElementById('ficheirosError').classList.add('show');
            return false;
        }
    });
</script>