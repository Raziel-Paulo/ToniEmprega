@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToniEmprega</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body>
    @{
        // ALTERAÇÃO: Verificar estado de validação do utilizador
        var userId = Context.Session.GetInt32("UserId");
        var userType = Context.Session.GetString("UserType");
        var isValidated = false;

        if (userId.HasValue)
        {
            // Injetar DbContext para verificar estado
            var dbContext = Context.RequestServices.GetService<ToniEmprega.Data.ApplicationDbContext>();
            if (dbContext != null)
            {
                var utilizador = dbContext.Utilizadores
                .AsNoTracking()
                .FirstOrDefault(u => u.Id == userId.Value);

                isValidated = utilizador?.Id_Estado_Validacao_Utilizador == 2;
            }
        }
    }

    <nav class="navbar">
        <div class="nav-container">
            <a class="nav-brand" href="/">
                <img src="~/images/logo.png" alt="ToniEmprega" style="height: 40px; width: auto; margin-right: 10px;" />
                ToniEmprega
            </a>

            <button class="nav-toggle" onclick="toggleMenu()">
                <i class="fas fa-bars"></i>
            </button>

            <div class="nav-menu" id="navMenu">
                <ul class="nav-list">
                    <li><a href="/" class="nav-link"><i class="fas fa-home"></i> Início</a></li>
                    <li><a href="/Ofertas" class="nav-link"><i class="fas fa-briefcase"></i> Ofertas</a></li>

                    @if (userType == "Aluno")
                    {
                        <li><a href="/Aluno/Dashboard" class="nav-link"><i class="fas fa-user-graduate"></i> Área Aluno</a></li>

                        <!-- ALTERAÇÃO: Só mostrar "Validar" se NÃO estiver validado -->
                        @if (!isValidated)
                        {
                            <li><a href="/Validacao/Index" class="nav-link"><i class="fas fa-shield-alt"></i> Validar</a></li>
                        }
                    }
                    else if (userType == "Empresa")
                    {
                        <li><a href="/Empresa/Dashboard" class="nav-link"><i class="fas fa-building"></i> Área Empresa</a></li>

                        <!-- ALTERAÇÃO: Só mostrar "Validar" se NÃO estiver validado -->
                        @if (!isValidated)
                        {
                            <li><a href="/Validacao/Index" class="nav-link"><i class="fas fa-shield-alt"></i> Validar</a></li>
                        }
                    }
                    else if (userType == "Professor")
                    {
                        <li><a href="/Professor/Dashboard" class="nav-link"><i class="fas fa-chalkboard-teacher"></i> Área Professor</a></li>

                        <!-- ALTERAÇÃO: Só mostrar "Validar" se NÃO estiver validado -->
                        @if (!isValidated)
                        {
                            <li><a href="/Validacao/Index" class="nav-link"><i class="fas fa-shield-alt"></i> Validar</a></li>
                        }
                    }
                    else if (userType == "Administrador")
                    {
                        <li><a href="/Admin/Dashboard" class="nav-link"><i class="fas fa-cog"></i> Administração</a></li>
                    }

                    @if (userId != null)
                    {
                        <li class="nav-user">
                            <a href="/Notificacoes" class="nav-link" style="position: relative;">
                                <i class="fas fa-bell"></i>
                                <span id="notif-count" style="display: none; position: absolute; top: -5px; right: -5px;
                                            background: var(--color-danger); color: white; border-radius: 50%; padding: 2px 6px; font-size: 0.7rem;">
                                </span>
                            </a>
                            <span class="user-name"><i class="fas fa-user"></i> @Context.Session.GetString("UserName")</span>
                            <a href="/Account/Perfil" class="btn btn-outline btn-sm"><i class="fas fa-cog"></i></a>
                            <a href="/Account/Logout" class="btn btn-outline"><i class="fas fa-sign-out-alt"></i> Sair</a>
                        </li>
                    }
                    else
                    {
                        <li><a href="/Account/Login" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> Entrar</a></li>
                        <li><a href="/Account/Register" class="btn btn-outline"><i class="fas fa-user-plus"></i> Registar</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> @TempData["Warning"]
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-content">
            <img src="~/images/logo.png" alt="ToniEmprega" style="height: 30px; opacity: 0.7; margin-bottom: 1rem;" />
            <p>&copy; 2025 ToniEmprega - Escola Profissional Gustave Eiffel</p>
            <p class="footer-links">
                <a href="/Home/Privacy">Privacidade</a> |
                <a href="#">Termos de Uso</a> |
                <a href="#">Contacto</a>
            </p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Atualizar contador de notificações
        async function updateNotifCount() {
            try {
                const response = await fetch('/Notificacoes/Contador');
                const count = await response.json();
                const badge = document.getElementById('notif-count');
                if (count > 0) {
                    badge.textContent = count > 9 ? '9+' : count;
                    badge.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) {
                console.error('Erro ao carregar notificações:', e);
            }
        }

        updateNotifCount();
        setInterval(updateNotifCount, 30000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>