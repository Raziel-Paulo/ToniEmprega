@model IEnumerable<ToniEmprega.Models.Notificacao>
@{
    ViewData["Title"] = "Notificações";
}

<style>
    .notif-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .notif-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .notif-page-header h2 {
            color: var(--color-blue);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .notif-actions {
        display: flex;
        gap: 0.75rem;
    }

    .notif-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .notif-card {
        background: var(--color-dark-gray);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        text-decoration: none;
    }

        .notif-card:hover {
            border-color: var(--color-blue);
            transform: translateX(5px);
            box-shadow: 0 4px 20px rgba(30, 144, 255, 0.1);
        }

        .notif-card.unread {
            background: rgba(30, 144, 255, 0.05);
            border-left: 3px solid var(--color-blue);
        }

        .notif-card.read {
            opacity: 0.7;
        }

            .notif-card.read:hover {
                opacity: 1;
            }

    /* Ícone com animação */
    .notif-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .notif-card:hover .notif-card-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .notif-card-icon.success {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
        border: 2px solid rgba(40, 167, 69, 0.25);
    }

    .notif-card-icon.error {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
        border: 2px solid rgba(220, 53, 69, 0.25);
    }

    .notif-card-icon.warning {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 2px solid rgba(255, 193, 7, 0.25);
    }

    .notif-card-icon.info {
        background: rgba(30, 144, 255, 0.15);
        color: var(--color-blue);
        border: 2px solid rgba(30, 144, 255, 0.25);
    }

    /* Conteúdo */
    .notif-card-content {
        flex: 1;
        min-width: 0;
    }

    .notif-card-title {
        color: var(--color-white);
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 0.4rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .notif-card-message {
        color: var(--color-gray);
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }

    .notif-card-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .notif-card-time {
        color: var(--color-gray);
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .notif-card-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 500;
    }

        .notif-card-badge.unread {
            background: rgba(30, 144, 255, 0.15);
            color: var(--color-blue);
            border: 1px solid rgba(30, 144, 255, 0.3);
        }

    /* Botão de ação */
    .notif-card-action {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.4rem 0.8rem;
        background: var(--color-navy);
        color: var(--color-blue);
        border: 1px solid var(--color-navy);
        border-radius: 6px;
        font-size: 0.8rem;
        text-decoration: none;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .notif-card-action:hover {
            background: var(--color-blue);
            color: white;
            border-color: var(--color-blue);
        }

    /* Estado vazio */
    .notif-empty {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--color-gray);
    }

        .notif-empty i {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            opacity: 0.3;
            animation: emptyBell 3s ease-in-out infinite;
        }

    @@keyframes emptyBell {
        0%, 100% {
            transform: rotate(0deg);
        }

        10% {
            transform: rotate(15deg);
        }

        20% {
            transform: rotate(-15deg);
        }

        30% {
            transform: rotate(10deg);
        }

        40% {
            transform: rotate(-10deg);
        }

        50% {
            transform: rotate(5deg);
        }

        60% {
            transform: rotate(-5deg);
        }

        70% {
            transform: rotate(0deg);
        }
    }

    .notif-empty h3 {
        color: var(--color-white);
        margin-bottom: 0.5rem;
    }

    /* Filtros */
    .notif-filters {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .notif-filter-btn {
        padding: 0.5rem 1rem;
        background: var(--color-navy);
        color: var(--color-gray);
        border: 1px solid var(--color-navy);
        border-radius: 20px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .notif-filter-btn:hover,
        .notif-filter-btn.active {
            background: var(--color-blue);
            color: white;
            border-color: var(--color-blue);
        }

    /* Responsivo */
    @@media (max-width: 576px) {
        .notif-page {
            padding: 1rem 0.75rem;
        }

        .notif-card {
            padding: 1rem;
        }

        .notif-card-icon {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        .notif-page-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="notif-page">
    <div class="notif-page-header">
        <h2><i class="fas fa-bell"></i> Notificações</h2>
        <div class="notif-actions">
            @if (Model.Any(n => !n.Lida))
            {
                <form method="post" asp-action="MarcarTodasComoLidas" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline btn-sm">
                        <i class="fas fa-check-double"></i> Marcar todas como lidas
                    </button>
                </form>
            }
        </div>
    </div>

    @* Filtros *@
    <div class="notif-filters">
        <button class="notif-filter-btn active" onclick="filtrarNotificacoes('todas')">
            <i class="fas fa-list"></i> Todas
            <span class="badge badge-pending" style="margin-left: 0.3rem;">@Model.Count()</span>
        </button>
        <button class="notif-filter-btn" onclick="filtrarNotificacoes('nao-lidas')">
            <i class="fas fa-envelope"></i> Não lidas
            <span class="badge badge-pending" style="margin-left: 0.3rem;">@Model.Count(n => !n.Lida)</span>
        </button>
        <button class="notif-filter-btn" onclick="filtrarNotificacoes('lidas')">
            <i class="fas fa-envelope-open"></i> Lidas
            <span class="badge badge-pending" style="margin-left: 0.3rem;">@Model.Count(n => n.Lida)</span>
        </button>
    </div>

    @if (Model.Any())
    {
        <div class="notif-list" id="notifList">
            @foreach (var notif in Model)
            {
                var iconClass = notif.Tipo switch
                {
                    "success" => "fa-check-circle",
                    "error" => "fa-times-circle",
                    "warning" => "fa-exclamation-triangle",
                    _ => "fa-info-circle"
                };

                <div class="notif-card @(notif.Lida ? "read" : "unread")"
                     data-lida="@(notif.Lida ? "true" : "false")"
                     data-tipo="@notif.Tipo">
                    <div class="notif-card-icon @notif.Tipo">
                        <i class="fas @iconClass"></i>
                    </div>
                    <div class="notif-card-content">
                        <div class="notif-card-title">
                            @notif.Titulo
                            @if (!notif.Lida)
                            {
                                <span class="notif-card-badge unread">
                                    <i class="fas fa-circle" style="font-size: 0.5rem;"></i> Nova
                                </span>
                            }
                        </div>
                        <div class="notif-card-message">@notif.Mensagem</div>
                        <div class="notif-card-meta">
                            <span class="notif-card-time">
                                <i class="far fa-clock"></i>
                                @notif.Data_Criacao.ToString("dd/MM/yyyy HH:mm")
                            </span>
                            @if (!string.IsNullOrEmpty(notif.Link))
                            {
                                <a href="@notif.Link" class="notif-card-action">
                                    <i class="fas fa-arrow-right"></i> Ver detalhes
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="notif-empty">
            <i class="fas fa-bell-slash"></i>
            <h3>Não tem notificações</h3>
            <p>Quando receber notificações, elas aparecerão aqui.</p>
        </div>
    }
</div>

<script>
    function filtrarNotificacoes(filtro) {
        // Atualizar botões ativos
        document.querySelectorAll('.notif-filter-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        event.target.closest('.notif-filter-btn').classList.add('active');

        // Filtrar cards
        const cards = document.querySelectorAll('.notif-card');
        cards.forEach(card => {
            const isLida = card.dataset.lida === 'true';

            switch (filtro) {
                case 'nao-lidas':
                    card.style.display = isLida ? 'none' : 'flex';
                    break;
                case 'lidas':
                    card.style.display = isLida ? 'flex' : 'none';
                    break;
                default:
                    card.style.display = 'flex';
            }
        });
    }

    // Animação de entrada staggered
    document.addEventListener('DOMContentLoaded', function () {
        const cards = document.querySelectorAll('.notif-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = 'all 0.4s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 80);
        });
    });
</script>