@* Views/Account/RecuperarPassword.cshtml (NOVO) *@
@{
    ViewData["Title"] = "Recuperar Password";
}

<div style="max-width: 450px; margin: 2rem auto;">
    <div class="card">
        <div class="card-header" style="text-align: center;">
            <h2 class="card-title"><i class="fas fa-key"></i> Recuperar Password</h2>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
        }

        <p style="color: var(--color-gray); margin-bottom: 1.5rem; text-align: center;">
            Introduza o seu email para receber um código de recuperação.
        </p>

        <form method="post">
            <div class="form-group">
                <label class="form-label"><i class="fas fa-envelope"></i> Email</label>
                <input type="email" name="email" class="form-control" required placeholder="seu.email@exemplo.com" />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">
                <i class="fas fa-paper-plane"></i> Enviar Código
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem;">
            <a href="/Account/Login" class="btn btn-outline" style="width: 100%;">
                <i class="fas fa-arrow-left"></i> Voltar ao Login
            </a>
        </div>
    </div>
</div>