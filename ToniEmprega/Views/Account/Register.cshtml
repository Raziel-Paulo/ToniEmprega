@* Views/Account/Register.cshtml *@
@model ToniEmprega.Models.Utilizador
@{
    ViewData["Title"] = "Registo";
}

<div style="max-width: 550px; margin: 2rem auto;">
    <div class="card">
        <div class="card-header" style="text-align: center;">
            <h2 class="card-title"><i class="fas fa-user-plus"></i> Criar Conta</h2>
        </div>

        <div asp-validation-summary="All" class="alert alert-error" style="display: @(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

        <p style="color: var(--color-gray); text-align: center; margin: 0 1.5rem 1rem;">
            Depois de submeter o formulário, será enviado um código para confirmar o email antes de concluir o registo.
        </p>

        <form method="post" asp-action="Register">
            <div class="form-group">
                <label class="form-label"><i class="fas fa-user"></i> Nome Completo</label>
                <input asp-for="Nome" class="form-control" required placeholder="Seu nome completo" />
            </div>

            <div class="form-group">
                <label class="form-label"><i class="fas fa-envelope"></i> Email</label>
                <input asp-for="Email" type="email" class="form-control" required placeholder="seu.email@exemplo.com" />
            </div>

            <div class="form-group">
                <label class="form-label"><i class="fas fa-calendar"></i> Data de Nascimento</label>
                <input asp-for="Data_Nascimento" type="date" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label"><i class="fas fa-user-tag"></i> Tipo de Utilizador</label>
                <select asp-for="Id_Tipo_Utilizador" class="form-control" required id="tipoUtilizador" onchange="mostrarTurmas()">
                    <option value="">Selecione...</option>
                    @foreach (var tipo in ViewBag.TiposUtilizador)
                    {
                        <option value="@tipo.Id">@tipo.Designacao</option>
                    }
                </select>
            </div>

            <!-- ✅ COMBO DE TURMAS - SÓ APARECE PARA ALUNOS -->
            <div class="form-group" id="turmaGroup" style="display: none;">
                <label class="form-label"><i class="fas fa-users"></i> Turma <span style="color: var(--color-danger);">*</span></label>
                <select name="idTurma" id="idTurma" class="form-control">
                    <option value="">Selecione a turma...</option>
                    @if (ViewBag.Turmas != null)
                    {
                        @foreach (var turma in ViewBag.Turmas)
                        {
                            <option value="@turma.Id">@turma.Designacao</option>
                        }
                    }
                </select>
                <small style="color: var(--color-gray);">Obrigatório para alunos</small>
            </div>

            <div class="form-group">
                <label class="form-label"><i class="fas fa-lock"></i> Palavra-passe</label>
                <input asp-for="Palavra_Passe" type="password" class="form-control" required placeholder="Mínimo 8 caracteres" />
            </div>

            <div class="form-group">
                <label class="form-label"><i class="fas fa-lock"></i> Confirmar Palavra-passe</label>
                <input name="confirmPassword" type="password" class="form-control" required placeholder="Repita a palavra-passe" />
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.8rem;">
                <i class="fas fa-user-plus"></i> Criar Conta
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-navy);">
            <p style="color: var(--color-gray); margin-bottom: 0.5rem;">Já tem conta?</p>
            <a href="/Account/Login" class="btn btn-outline" style="width: 100%;">
                <i class="fas fa-sign-in-alt"></i> Iniciar Sessão
            </a>
        </div>
    </div>
</div>

<script>
    function mostrarTurmas() {
        var tipoSelect = document.getElementById('tipoUtilizador');
        var turmaGroup = document.getElementById('turmaGroup');
        var turmaSelect = document.getElementById('idTurma');

        // ID 1 = Aluno (verifica o teu seed data)
        if (tipoSelect.value == '1') {
            turmaGroup.style.display = 'block';
            turmaSelect.required = true;
        } else {
            turmaGroup.style.display = 'none';
            turmaSelect.required = false;
            turmaSelect.value = '';
        }
    }

    // Verificar no carregamento da página (se houver erro de validação e o tipo já estiver selecionado)
    document.addEventListener('DOMContentLoaded', function () {
        mostrarTurmas();
    });
</script>