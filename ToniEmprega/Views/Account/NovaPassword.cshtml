@* Views/Account/NovaPassword.cshtml (NOVO) *@
@{
    ViewData["Title"] = "Nova Password";
}

<div style="max-width: 450px; margin: 2rem auto;">
    <div class="card">
        <div class="card-header" style="text-align: center;">
            <h2 class="card-title"><i class="fas fa-lock"></i> Definir Nova Password</h2>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
        }

        <p style="color: var(--color-gray); margin-bottom: 1.5rem; text-align: center;">
            A nova password deve ter pelo menos 8 caracteres, incluindo maiúsculas, minúsculas, números e caracteres especiais.
        </p>

        <form method="post">
            <div class="form-group">
                <label class="form-label"><i class="fas fa-lock"></i> Nova Password</label>
                <input type="password" name="novaPassword" class="form-control" required
                       minlength="8" placeholder="********" />
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fas fa-lock"></i> Confirmar Password</label>
                <input type="password" name="confirmarPassword" class="form-control" required
                       minlength="8" placeholder="********" />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">
                <i class="fas fa-save"></i> Alterar Password
            </button>
        </form>
    </div>
</div>