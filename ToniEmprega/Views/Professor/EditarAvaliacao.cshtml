﻿@* Views/Professor/EditarAvaliacao.cshtml *@
@model ToniEmprega.Models.AvaliacaoProfessor
@{
    ViewData["Title"] = "Editar Avaliação";
}

<div style="max-width: 800px; margin: 0 auto;">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title"><i class="fas fa-edit"></i> Editar Avaliação</h2>
        </div>

        <div style="background-color: var(--color-navy); padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
            <h3 style="color: var(--color-white); margin-bottom: 0.5rem;">@Model.Candidatura?.Oferta?.Titulo</h3>
            <p style="color: var(--color-gray); margin: 0;">
                <i class="fas fa-user"></i> @Model.Candidatura?.Aluno?.Utilizador?.Nome |
                <i class="fas fa-graduation-cap"></i> @Model.Candidatura?.Aluno?.Curso
            </p>

            @if (Model.Candidatura?.Ficheiros != null && Model.Candidatura.Ficheiros.Any())
            {
                <div style="margin-top: 1rem; padding: 1rem; background-color: var(--color-dark-gray); border-radius: 6px;">
                    <strong style="color: var(--color-blue); display: block; margin-bottom: 0.75rem;">Ficheiros anexados:</strong>
                    <ul style="margin: 0; padding-left: 1.2rem; color: var(--color-gray);">
                        @foreach (var ficheiro in Model.Candidatura.Ficheiros)
                        {
                            <li style="margin-bottom: 0.5rem;">
                                <a href="@ficheiro.Caminho_Ficheiro" target="_blank" style="color: var(--color-blue);">
                                    <i class="fas fa-paperclip"></i> @ficheiro.Nome_Ficheiro
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <form method="post" asp-action="EditarAvaliacao" id="formAvaliacao">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-group">
                <label class="form-label"><i class="fas fa-balance-scale"></i> Decisão</label>
                <select name="decisaoId" class="form-control" required>
                    @foreach (var decisao in ViewBag.Decisoes)
                    {
                        if (Model.Id_Decisao_Avaliacao == decisao.Id)
                        {
                            <option value="@decisao.Id" selected>@decisao.Designacao</option>
                        }
                        else
                        {
                            <option value="@decisao.Id">@decisao.Designacao</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label"><i class="fas fa-comment-alt"></i> Comentários <span style="color: var(--color-danger);">*</span></label>
                <!-- ✅ MIN 50, MAX 200 caracteres -->
                <textarea name="comentarios" id="comentarios" class="form-control" rows="4"
                          placeholder="Justificação da tua decisão (mínimo 50, máximo 200 caracteres)..."
                          minlength="50" maxlength="200" required>@Model.Comentarios</textarea>
                <div style="display: flex; justify-content: space-between; margin-top: 0.3rem;">
                    <small id="erro-comentarios" style="color: var(--color-danger); display: none;">
                        <i class="fas fa-exclamation-circle"></i> Mínimo 50 caracteres.
                    </small>
                    <small id="contador-caracteres" style="color: var(--color-gray); margin-left: auto;">
                        @(Model.Comentarios?.Length ?? 0)/200
                    </small>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">
                    <i class="fas fa-save"></i> Guardar Alterações
                </button>
                <a href="/Professor/MinhasAvaliacoes" class="btn btn-outline">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
    const textarea = document.getElementById('comentarios');
    const contador = document.getElementById('contador-caracteres');
    const erro = document.getElementById('erro-comentarios');

    function atualizarContador() {
        const len = textarea.value.length;
        contador.textContent = len + '/200';

        if (len < 50) {
            contador.style.color = 'var(--color-danger)';
            erro.style.display = 'block';
        } else {
            contador.style.color = 'var(--color-gray)';
            erro.style.display = 'none';
        }
    }

    textarea.addEventListener('input', atualizarContador);
    atualizarContador(); // Inicializar

    // Validação no submit
    document.getElementById('formAvaliacao').addEventListener('submit', function(e) {
        const len = textarea.value.length;
        if (len < 50) {
            e.preventDefault();
            alert('Os comentários devem ter no mínimo 50 caracteres. Atualmente: ' + len);
            textarea.focus();
            return false;
        }
        if (len > 200) {
            e.preventDefault();
            alert('Os comentários devem ter no máximo 200 caracteres. Atualmente: ' + len);
            textarea.focus();
            return false;
        }
        return true;
    });
</script>