@* Views/Professor/MinhasAvaliacoes.cshtml *@
@model IEnumerable<ToniEmprega.Models.AvaliacaoProfessor>
@{
    ViewData["Title"] = "Histórico de Avaliações";
}

<style>
    .prof-dashboard {
        display: flex;
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .prof-sidebar {
        width: 260px;
        flex-shrink: 0;
    }

        .prof-sidebar .menu-card {
            background: var(--color-dark-gray);
            border: 1px solid var(--color-navy);
            border-radius: 12px;
            padding: 1.5rem;
        }

        .prof-sidebar .menu-title {
            color: var(--color-blue);
            margin-bottom: 1.5rem;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .prof-sidebar .menu-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--color-gray);
            text-decoration: none;
            margin-bottom: 0.5rem;
            transition: all 0.2s;
        }

            .prof-sidebar .menu-link:hover,
            .prof-sidebar .menu-link.active {
                background: var(--color-navy);
                color: var(--color-blue);
            }

    .prof-main {
        flex: 1;
        min-width: 0;
    }

    .prof-header {
        margin-bottom: 1.5rem;
    }

        .prof-header h2 {
            color: var(--color-blue);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .avaliacoes-card {
        background: var(--color-dark-gray);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
        padding: 1.5rem;
        overflow-x: auto;
    }

    .avaliacoes-table {
        width: 100%;
        border-collapse: collapse;
    }

        .avaliacoes-table th {
            text-align: left;
            padding: 1rem;
            color: var(--color-blue);
            border-bottom: 2px solid var(--color-navy);
            white-space: nowrap;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .avaliacoes-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--color-navy);
            vertical-align: middle;
        }

        .avaliacoes-table tr:last-child td {
            border-bottom: none;
        }

    .badge-decisao {
        display: inline-block;
        padding: 0.35rem 0.8rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .badge-aprovado {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .badge-rejeitado {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .badge-revisao {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .badge-emp-decidida {
        background: rgba(30, 144, 255, 0.2);
        color: var(--color-blue);
        border: 1px solid rgba(30, 144, 255, 0.3);
    }

    .comentario-texto {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--color-gray);
        font-size: 0.9rem;
    }

    .btn-acao {
        padding: 0.4rem 0.8rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-editar {
        background: var(--color-blue);
        color: white;
    }

        .btn-editar:hover {
            background: #1873cc;
        }

    .btn-bloqueado {
        background: rgba(128, 128, 128, 0.2);
        color: #888;
        border: 1px solid rgba(128, 128, 128, 0.3);
        cursor: not-allowed;
    }

    .sem-avaliacoes {
        text-align: center;
        padding: 3rem;
        color: var(--color-gray);
    }

        .sem-avaliacoes i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

    @@media (max-width: 768px) {
        .prof-dashboard {
            flex-direction: column;
            padding: 1rem;
        }

        .prof-sidebar {
            width: 100%;
        }
    }
</style>

<div class="prof-dashboard">
    <div class="prof-sidebar">
        <div class="menu-card">
            <h3 class="menu-title"><i class="fas fa-chalkboard-teacher"></i> Menu</h3>
            <a href="/Professor/Dashboard" class="menu-link">
                <i class="fas fa-home"></i> Dashboard
            </a>
            <a href="/Professor/Candidaturas" class="menu-link">
                <i class="fas fa-clipboard-check"></i> Avaliar Candidaturas
            </a>
            <a href="/Professor/MinhasAvaliacoes" class="menu-link active">
                <i class="fas fa-history"></i> Minhas Avaliações
            </a>
        </div>
    </div>

    <div class="prof-main">
        <div class="prof-header">
            <h2><i class="fas fa-history"></i> Histórico de Avaliações</h2>
        </div>

        <div class="avaliacoes-card">
            @if (Model.Any())
            {
                <table class="avaliacoes-table">
                    <thead>
                        <tr>
                            <th>Aluno</th>
                            <th>Oferta</th>
                            <th>Decisão</th>
                            <th>Data</th>
                            <th>Comentários</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var aval in Model)
                        {
                            var empresaDecidiu = aval.Candidatura?.Id_Estado_Candidatura_Empresa == 3 || aval.Candidatura?.Id_Estado_Candidatura_Empresa == 4;
                            var empresaAprovou = aval.Candidatura?.Id_Estado_Candidatura_Empresa == 3;
                            var empresaRejeitou = aval.Candidatura?.Id_Estado_Candidatura_Empresa == 4;

                            <tr>
                                <td><strong style="color: var(--color-white);">@aval.Candidatura?.Aluno?.Utilizador?.Nome</strong></td>
                                <td style="color: var(--color-gray);">@aval.Candidatura?.Oferta?.Titulo</td>
                                <td>
                                    @if (aval.DecisaoAvaliacao?.Id == 1)
                                    {
                                        <span class="badge-decisao badge-aprovado"><i class="fas fa-check"></i> Aprovado</span>
                                    }
                                    else if (aval.DecisaoAvaliacao?.Id == 2)
                                    {
                                        <span class="badge-decisao badge-rejeitado"><i class="fas fa-times"></i> Rejeitado</span>
                                    }
                                    else
                                    {
                                        <span class="badge-decisao badge-revisao"><i class="fas fa-exclamation-triangle"></i> Revisão</span>
                                    }
                                </td>
                                <td style="white-space: nowrap; color: var(--color-gray);">@aval.Data_Avaliacao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="comentario-texto" title="@aval.Comentarios">@aval.Comentarios</div>
                                </td>
                                <td>
                                    @if (empresaDecidiu)
                                    {
                                        <span class="btn-acao btn-bloqueado" title="A empresa já decidiu sobre esta candidatura">
                                            <i class="fas fa-lock"></i> @(empresaAprovou ? "Empresa Aprovou" : "Empresa Rejeitou")
                                        </span>
                                    }
                                    else
                                    {
                                        <a href="/Professor/EditarAvaliacao/@aval.Id" class="btn-acao btn-editar">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="sem-avaliacoes">
                    <i class="fas fa-inbox"></i>
                    <h3>Ainda não realizou nenhuma avaliação</h3>
                </div>
            }
        </div>
    </div>
</div>