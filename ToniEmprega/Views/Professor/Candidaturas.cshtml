@* Views/Professor/Candidaturas.cshtml *@
@model IEnumerable<ToniEmprega.Models.Candidatura>
@{
    ViewData["Title"] = "Candidaturas para Avaliação";
}

<style>
    .prof-dashboard {
        display: flex;
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .prof-sidebar {
        width: 260px;
        flex-shrink: 0;
    }

        .prof-sidebar .menu-card {
            background: var(--color-dark-gray);
            border: 1px solid var(--color-navy);
            border-radius: 12px;
            padding: 1.5rem;
        }

        .prof-sidebar .menu-title {
            color: var(--color-blue);
            margin-bottom: 1.5rem;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .prof-sidebar .menu-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--color-gray);
            text-decoration: none;
            margin-bottom: 0.5rem;
            transition: all 0.2s;
        }

            .prof-sidebar .menu-link:hover,
            .prof-sidebar .menu-link.active {
                background: var(--color-navy);
                color: var(--color-blue);
            }

    .prof-main {
        flex: 1;
        min-width: 0;
    }

    .prof-header {
        margin-bottom: 1.5rem;
    }

        .prof-header h2 {
            color: var(--color-blue);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    /* Filtros */
    .filtros-card {
        background: var(--color-dark-gray);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .filtros-form {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }

        .filtros-form .form-group {
            margin-bottom: 0;
            flex: 1;
            min-width: 200px;
        }

        .filtros-form label {
            color: var(--color-gray);
            font-size: 0.85rem;
            margin-bottom: 0.3rem;
            display: block;
        }

        .filtros-form .form-control {
            width: 100%;
            padding: 0.6rem 0.8rem;
            background: var(--color-black);
            border: 1px solid var(--color-navy);
            border-radius: 6px;
            color: var(--color-white);
            transition: border-color 0.3s;
        }

            .filtros-form .form-control:focus {
                outline: none;
                border-color: var(--color-blue);
            }

        .filtros-form .btn-limpar {
            padding: 0.6rem 1.2rem;
            background: transparent;
            color: var(--color-gray);
            border: 1px solid var(--color-navy);
            border-radius: 6px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            cursor: pointer;
            transition: all 0.2s;
        }

            .filtros-form .btn-limpar:hover {
                border-color: var(--color-blue);
                color: var(--color-blue);
            }

    .candidaturas-card {
        background: var(--color-dark-gray);
        border: 1px solid var(--color-navy);
        border-radius: 12px;
        padding: 1.5rem;
        overflow-x: auto;
    }

    .candidaturas-table {
        width: 100%;
        border-collapse: collapse;
    }

        .candidaturas-table th {
            text-align: left;
            padding: 1rem;
            color: var(--color-blue);
            border-bottom: 2px solid var(--color-navy);
            white-space: nowrap;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .candidaturas-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--color-navy);
            vertical-align: middle;
        }

        .candidaturas-table tr {
            min-height: 80px;
        }

            .candidaturas-table tr:last-child td {
                border-bottom: none;
            }

            /* ✅ Linha escondida pelo filtro JS */
            .candidaturas-table tr.hidden-row {
                display: none !important;
            }

    .badge-estado {
        display: inline-block;
        padding: 0.35rem 0.8rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .badge-pendente {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .badge-analise {
        background: rgba(30, 144, 255, 0.2);
        color: var(--color-blue);
        border: 1px solid rgba(30, 144, 255, 0.3);
    }

    .badge-aprovado {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .badge-rejeitado {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .btn-acao {
        padding: 0.4rem 0.8rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-avaliar {
        background: var(--color-blue);
        color: white;
    }

        .btn-avaliar:hover {
            background: #1873cc;
        }

    .btn-ver {
        background: transparent;
        color: var(--color-blue);
        border: 1px solid var(--color-blue);
    }

        .btn-ver:hover {
            background: var(--color-blue);
            color: white;
        }

    .info-aluno {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .aluno-nome {
        color: var(--color-white);
        font-weight: 600;
        font-size: 1rem;
    }

    .aluno-email {
        color: var(--color-gray);
        font-size: 0.85rem;
    }

    .aluno-meta {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    .aluno-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .tag-turma {
        background: rgba(30, 144, 255, 0.15);
        color: var(--color-blue);
        border: 1px solid rgba(30, 144, 255, 0.3);
    }

    .tag-numero {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .tag-curso {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .sem-candidaturas {
        text-align: center;
        padding: 3rem;
        color: var(--color-gray);
    }

        .sem-candidaturas i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

    /* ✅ Contador de resultados */
    .resultados-info {
        color: var(--color-gray);
        font-size: 0.9rem;
        margin-bottom: 1rem;
        padding: 0 0.5rem;
    }

        .resultados-info strong {
            color: var(--color-blue);
        }

    @@media (max-width: 768px) {
        .prof-dashboard {
            flex-direction: column;
            padding: 1rem;
        }

        .prof-sidebar {
            width: 100%;
        }

        .filtros-form {
            flex-direction: column;
        }

            .filtros-form .form-group {
                min-width: 100%;
            }
    }
</style>

<div class="prof-dashboard">
    <div class="prof-sidebar">
        <div class="menu-card">
            <h3 class="menu-title"><i class="fas fa-chalkboard-teacher"></i> Menu</h3>
            <a href="/Professor/Dashboard" class="menu-link">
                <i class="fas fa-home"></i> Dashboard
            </a>
            <a href="/Professor/Candidaturas" class="menu-link active">
                <i class="fas fa-clipboard-check"></i> Avaliar Candidaturas
            </a>
            <a href="/Professor/MinhasAvaliacoes" class="menu-link">
                <i class="fas fa-history"></i> Minhas Avaliações
            </a>
        </div>
    </div>

    <div class="prof-main">
        <div class="prof-header">
            <h2><i class="fas fa-clipboard-check"></i> Candidaturas para Avaliação</h2>
        </div>

        <!-- ✅ Filtros com pesquisa em tempo real -->
        <div class="filtros-card">
            <div class="filtros-form">
                <div class="form-group">
                    <label><i class="fas fa-users"></i> Turma</label>
                    <select id="filtroTurma" class="form-control" onchange="filtrarTabela()">
                        <option value="">Todas as turmas</option>
                        @foreach (var turma in ViewBag.Turmas)
                        {
                            <option value="@turma.Designacao" selected="@(ViewBag.TurmaId == turma.Id)">
                                @turma.Designacao
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-hashtag"></i> Número de Aluno</label>
                    <input type="text" id="filtroNumero" class="form-control"
                           value="@ViewBag.NumeroAluno"
                           placeholder="Digite o número..."
                           maxlength="20"
                           oninput="filtrarTabela()" />
                </div>
                <button type="button" class="btn-limpar" onclick="limparFiltros()">
                    <i class="fas fa-times"></i> Limpar
                </button>
            </div>
        </div>

        <!-- ✅ Contador de resultados visíveis -->
        <div class="resultados-info">
            <i class="fas fa-list"></i> A mostrar <strong id="contadorResultados">@Model.Count()</strong> candidaturas
        </div>

        <div class="candidaturas-card">
            @if (Model.Any())
            {
                <table class="candidaturas-table" id="tabelaCandidaturas">
                    <thead>
                        <tr>
                            <th>Aluno</th>
                            <th>Oferta</th>
                            <th>Empresa</th>
                            <th>Data</th>
                            <th>Estado</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cand in Model)
                        {
                            var jaAvaliou = cand.Avaliacoes?.Any(a => a.Id_Professor == ViewBag.ProfessorId) ?? false;
                            var minhaAvaliacao = cand.Avaliacoes?.FirstOrDefault(a => a.Id_Professor == ViewBag.ProfessorId);

                            <!-- ✅ data attributes para filtrar no JS -->
                            <tr data-turma="@(cand.Aluno?.Turma?.Designacao ?? "")"
                                data-numero="@(cand.Aluno?.Numero_Aluno ?? "")">

                                <td>
                                    <div class="info-aluno">
                                        <span class="aluno-nome">@cand.Aluno?.Utilizador?.Nome</span>
                                        <span class="aluno-email">@cand.Aluno?.Utilizador?.Email</span>
                                        <div class="aluno-meta">
                                            @if (cand.Aluno?.Turma != null)
                                            {
                                                <span class="aluno-tag tag-turma">
                                                    <i class="fas fa-users"></i> @cand.Aluno.Turma.Designacao
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(cand.Aluno?.Numero_Aluno))
                                            {
                                                <span class="aluno-tag tag-numero">
                                                    <i class="fas fa-hashtag"></i> @cand.Aluno.Numero_Aluno
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(cand.Aluno?.Curso))
                                            {
                                                <span class="aluno-tag tag-curso">
                                                    <i class="fas fa-graduation-cap"></i> @cand.Aluno.Curso
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <strong style="color: var(--color-white);">@cand.Oferta?.Titulo</strong>
                                </td>
                                <td style="color: var(--color-gray);">@cand.Oferta?.Empresa?.Nome_Empresa</td>
                                <td style="white-space: nowrap; color: var(--color-gray);">@cand.Data_Candidatura.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var estadoClasse = cand.Id_Estado_Candidatura switch
                                        {
                                            1 => "badge-pendente",
                                            2 => "badge-analise",
                                            5 => "badge-rejeitado",
                                            6 => "badge-aprovado",
                                            7 => "badge-rejeitado",
                                            _ => "badge-pendente"
                                        };
                                        var estadoTexto = cand.Id_Estado_Candidatura switch
                                        {
                                            1 => "Pendente",
                                            2 => "Em Análise",
                                            5 => "Cancelada",
                                            6 => "Aprovada",
                                            7 => "Rejeitada",
                                            _ => "Pendente"
                                        };
                                    }
                                    <span class="badge-estado @estadoClasse">@estadoTexto</span>
                                    @if (jaAvaliou && minhaAvaliacao != null)
                                    {
                                        <div style="margin-top: 0.4rem; font-size: 0.8rem; color: var(--color-gray);">
                                            <i class="fas fa-gavel"></i> Avaliado: @minhaAvaliacao.DecisaoAvaliacao?.Designacao
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (!jaAvaliou && (cand.Id_Estado_Candidatura == 1 || cand.Id_Estado_Candidatura == 2))
                                    {
                                        <a href="/Professor/Avaliar/@cand.Id" class="btn-acao btn-avaliar">
                                            <i class="fas fa-gavel"></i> Avaliar
                                        </a>
                                    }
                                    else if (jaAvaliou)
                                    {
                                        <a href="/Professor/EditarAvaliacao/@minhaAvaliacao?.Id" class="btn-acao btn-ver">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray); font-size: 0.85rem;">
                                            <i class="fas fa-lock"></i> Fechada
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- ✅ Mensagem quando não há resultados após filtro -->
                <div id="semResultados" class="sem-candidaturas" style="display: none;">
                    <i class="fas fa-search"></i>
                    <h3>Nenhuma candidatura corresponde aos filtros</h3>
                    <p>Tente ajustar a turma ou o número de aluno.</p>
                </div>
            }
            else
            {
                <div class="sem-candidaturas">
                    <i class="fas fa-inbox"></i>
                    <h3>Nenhuma candidatura encontrada</h3>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // ✅ FILTRO EM TEMPO REAL
    function filtrarTabela() {
        var turmaFiltro = document.getElementById('filtroTurma').value.toLowerCase().trim();
        var numeroFiltro = document.getElementById('filtroNumero').value.toLowerCase().trim();
        var linhas = document.querySelectorAll('#tabelaCandidaturas tbody tr');
        var visiveis = 0;
        var algumVisivel = false;

        linhas.forEach(function(linha) {
            var turma = (linha.getAttribute('data-turma') || '').toLowerCase();
            var numero = (linha.getAttribute('data-numero') || '').toLowerCase();

            // Verifica se corresponde aos filtros
            var matchTurma = !turmaFiltro || turma === turmaFiltro;
            var matchNumero = !numeroFiltro || numero.includes(numeroFiltro);

            if (matchTurma && matchNumero) {
                linha.classList.remove('hidden-row');
                visiveis++;
                algumVisivel = true;
            } else {
                linha.classList.add('hidden-row');
            }
        });

        // Atualiza contador
        document.getElementById('contadorResultados').textContent = visiveis;

        // Mostra/esconde mensagem de sem resultados
        var tabela = document.getElementById('tabelaCandidaturas');
        var semResultados = document.getElementById('semResultados');

        if (!algumVisivel && tabela) {
            tabela.style.display = 'none';
            if (semResultados) semResultados.style.display = 'block';
        } else if (tabela) {
            tabela.style.display = '';
            if (semResultados) semResultados.style.display = 'none';
        }
    }

    // ✅ LIMPAR FILTROS
    function limparFiltros() {
        document.getElementById('filtroTurma').value = '';
        document.getElementById('filtroNumero').value = '';
        filtrarTabela();
    }

    // Aplicar filtros ao carregar (se vierem valores da URL)
    document.addEventListener('DOMContentLoaded', function() {
        filtrarTabela();
    });
</script>